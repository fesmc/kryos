! Templates of the kryos par file groups (core-design.md section 5): the schema
! every group of a par file is validated against, and the defaults of the keys
! it leaves out. One group per template; the key is the unit of validation.
!
!   run, clock, schedule, globe, domain   one template each: [kryos], [clock],
!                                         [schedule], [globe], [domain]
!   instance                              [instance] (core keys) plus the template
!                                         [<component>_<backend>] of its backend
!                                         (backend keys); a key is valid if either
!                                         declares it (kryos_config)
!
! Backend physics groups (yelmo, isos, chion, ...) keep their own schemas in the
! libraries' defaults files (<library>_defaults.nml); data field groups follow
! input/datasrc_defaults.nml. The groups of code kryos hosts itself (the chion
! host's [orbit]) have their schema at the end of this file. "required" marks keys a group must set (checked
! by config_validate): the value shown is a placeholder.

&kryos
    domains         = ""                       ! the domain groups of the run
    globe           = "globe"                  ! the globe group
    clock           = "clock"                  ! the clock group
    restart         = "None"                   ! restart bundle to start from, or "None"
    restart_out     = "none"                   ! schedule group of the restart bundles
    out_dir         = "./"
    map_fldr        = "maps"
    phys_const      = "Earth"                  ! group of phys_const_file (one per run)
    phys_const_file = "input/phys_const.nml"
    library         = ""                       ! files of the named groups not in the par file
    write_lossless  = False
    log_level       = "info"                   ! debug | info | warn | error
    timing          = True
/

&clock
    time_init      = 0.0                       ! required [yr]
    time_end       = 0.0                       ! required [yr]
    dtt            = 0.0                       ! required [yr]
    method         = "rel"                     ! rel | cal | const (fesm_clock)
    time_ref       = 1950.0
    calendar       = "365_day"
    year           = "tropical"
    time_const     = 0.0                       ! method = const: exactly one of time_const, time_const_cal
    time_const_cal = 0.0
    ticks_per_year = 36000
/

&schedule
    method = "none"                            ! none | const | times | file (fesm_clock)
    dt     = 0.0
    times  = 0.0
    file   = ""
/

&globe
    forcing = ""                               ! the forcing instance
    geo     = ""                               ! the global part of geo
    climate = ""                               ! the global part of a two-level climate (paleoemu)
/

&domain
    grid_hub   = ""                            ! required
    topo       = "topo"
    regions    = "regions"
    basins     = ""
    out_2D     = "none"                        ! hub output schedule
    ice        = ""                            ! instance of each component, "" = absent
    geo        = ""
    climate    = ""
    surface    = ""
    shelf      = ""
    geothermal = ""
    sediments  = ""
    experiments = ""                           ! experiment groups, in call order (core-design 3.9); "" = none
/

&instance
    backend  = ""                              ! required
    grid     = ""                              ! "" = the default chain
    dt       = 0.0                             ! 0: every step; > 0: cadence; < 0: never after init
    phase    = 0.0
    clock    = "model"                         ! model | forcing
    out_2D   = "none"
    out_1D   = "none"
    out_vars = ""                              ! "" = all exports
/

&experiment
    kind = ""                                  ! required: the experiment kind; its keys are in [experiment_<kind>]
/

&experiment_host
    ! Experiments a host program passes to run_init (experiment_proto_t): any key is the host's.
/

&experiment_relax
    ! Relaxation of Yelmo's topography towards the reference, over the elapsed time (kryos_exp_relax).
    ! Defaults: yelmox_Antarctica [relax].
    topo_rel = 4                               ! ytopo.topo_rel mode while active (4: grounding line + grounding zone)
    tau1     = 100.0                           ! [yr] relaxation timescale until time1
    tau2     = 2000.0                          ! [yr] relaxation timescale at time2
    time1    = 2e3                             ! [yr] end of the tau1 period
    time2    = 6e3                             ! [yr] end of the relaxation (then the ytopo values apply)
    m        = 2.0                             ! [1] non-linear exponent of the tau1 -> tau2 ramp
/

&experiment_opt_cb_ref
    ! Optimisation of Yelmo's basal friction cb_ref (kryos_exp_opt_cb_ref); needs Yelmo's
    ! present-day velocity (&yelmo_data pd_vel_load). Defaults: yelmox_Antarctica [opt].
    method       = "L21"                       ! none (external cb_ref = cf_init or the till friction, no optimisation) | L21
    cf_time_init = 0.0                         ! [yr] elapsed time: optimisation starts
    cf_time_end  = 15e3                        ! [yr] elapsed time: optimisation stops
    cf_init      = 1e-2                        ! cold start: cb_ref everywhere (<= 0: the till friction of the bed, cb_tgt)
    tau_c        = 500.0                       ! [yr] L21: relaxation timescale
    H0           = 100.0                       ! [m] L21: ice-thickness error scaling
    sigma_err    = 50e3                        ! [m] smoothing radius of the error for the correction
    sigma_vel    = 100.0                       ! [m yr-1] speed at which the smoothing diminishes to zero
    fill_method  = "cf_min"                    ! nearest | analog | target | cf_min
/

&experiment_opt_tf
    ! Optimisation of the shelf component's thermal-forcing correction tf_corr (kryos_exp_opt_tf).
    ! Defaults: yelmox_Antarctica [opt].
    method       = "L21-points"                ! L21 (one correction per basin) | L21-points
    tf_time_init = 0.0                         ! [yr] elapsed time: optimisation starts
    tf_time_end  = 15e3                        ! [yr] elapsed time: optimisation stops
    H_grnd_lim   = 500.0                       ! [m] distance from the grounding line, as thickness above flotation
    tf_sigma     = 50e3                        ! [m] L21-points: smoothing radius of the error
    tau_m        = 100.0                       ! [yr] relaxation timescale
    m_temp       = 10.0                        ! [m yr-1 degC-1] scaling value
    tf_min       = -1.0                        ! [degC] minimum tf_corr
    tf_max       = 1.0                         ! [degC] maximum tf_corr
    tf_basins    = -1                          ! L21: basin numbers to optimise (-1: all)
    basin_fill   = False                       ! L21-points: fill grounded basins with the ice-shelf mean tf_corr
/

&experiment_recon
    ! Cold start from an ice reconstruction (kryos_exp_recon), after the ice state is initialised.
    recon_path    = ""                         ! required: the reconstruction file ({domain}, {grid_name} of the ice grid)
    recon_var     = ""                         ! required: its ice-thickness variable
    recon_time    = 0.0                        ! [yr] model time of the state (nearest slice of the file)
    recon_regions = ""                         ! required: where its ice is imposed: a regions selection expression, or "all"
                                               ! (every cell of the ice grid, no regions file read)
    recon_zb_min  = -500.0                     ! [m] the ice is imposed where z_bed > recon_zb_min (yelmox: -500; a very low value,
                                               ! e.g. -1e5, disables the filter: marine ice is kept)
    recon_smooth_sigma = 2.0                   ! [grid cells] Gaussian smoothing of the initial ice (yelmox: 2 dx); 0 (or less):
                                               ! no smoothing; otherwise >= 1. A start already smoothed (the science case:
                                               ! PaleoMIST at 25 km) uses 0
    recon_H_float_min  = 50.0                  ! [m] floating ice (mask_bed = 5) thinner than this is removed after the first
                                               ! year of equilibration (yelmox: 50); 0 (or less): kept. The science case uses 0
/

&forcing_tsgen
    coefs     = ""                             ! [coef_<name>] groups
    orbit     = ""                             ! the orbit group ([orbit]): exports orbit_ecc, orbit_obl, orbit_per; "" none
    out_insol = "none"                         ! schedule of <instance>_insol.nc (the orbit, monthly TOA insolation on 1° latitudes)
/

&geo_fastisostasy
    isos        = "isos"                       ! regional instance: the isos group
    bsl         = "barysealevel"               ! global instance: the barysealevel group
    out_isos    = "none"                       ! schedule of <instance>_isos.nc (z_bed, z_ss, w, we)
    out_isos_ts = "none"                       ! schedule of <instance>_isos_ts.nc (bsl, z_bed and w statistics)
    out_bsl_ts  = "none"                       ! global instance: schedule of <instance>_bsl_ts.nc
/

&geo_vilma2
    vilma  = "vilma"                           ! global instance: the &vilma group (overrides of input/vilma_defaults.nml)
    ice_bg = "globe_ice"                       ! global instance: the global ice field group
    allow_no_spinup = False                    ! global instance: a run without VILMA2's spin-up (pre_spinup_1d or equil_time_max > 0)
                                               ! stops unless True: the dt = 0 seed then solves the reference and the t0 load
                                               ! enters with the first call (tests, present-day starts only; plan 7.4)
    out_gia    = "none"                        ! global instance: schedule of <instance>_gia.nc (the global ice field VILMA2 got)
    out_vilma  = "none"                        ! global instance: schedule of <instance>_vilma.nc (VILMA2's own diagnostics file)
/

&ice_yelmo
    yelmo           = "yelmo"                  ! Yelmo's top group
    init_equil_time = 0.0                      ! [yr] cold start: yelmo_update_equil, 0 = none
    init_time_thrm  = 0.0                      ! [yr] cold start, after it: equilibrate at the run step with topography fixed, 0 = none
    till_cf         = ""                       ! group of the till cf_ref per basin or region (ids, codes, cf_ref), "" = none: ytill.cf_ref everywhere
    out_yelmo       = "none"                   ! schedule of <instance>_yelmo.nc (YELMO_VARS_2D)
    out_yelmo_sm    = "none"                   ! schedule of <instance>_yelmo_sm.nc (small 2D set)
    out_yelmo_ts    = "none"                   ! schedule of <instance>_yelmo_ts[_<region>].nc
/

&ice_data
    ! The ice geometry read, not solved: field groups (input/datasrc_defaults.nml) on the instance grid.
    H_ice = ""                                 ! the ice thickness [m]; "" = the domain's reference topography
    z_bed = ""                                 ! the bed [m]; "" = the domain's reference topography
    z_sl  = ""                                 ! the sea surface [m]; "" = 0
/

&ice_plastic
    ! The perfectly-plastic ice sheet (PlasticIceSheet; docs/dev/plastic-backend.md): at every update the ice
    ! mask of the margin chronology at t1 and tau_b at t1 on the imported bed and sea level give the thickness.
    drive              = "taub"                ! "taub": plastic_solve with the tau_b below | "smb": plastic_solve_smb with
                                               ! the imported smb (needs rheo_A and slide_law)
    ! solver (plastic_par_t)
    mode               = "surface"             ! the library's mode, passed through: "surface" (z_s directly, one sweep,
                                               ! with the bed) | "flat" (no bed slope) | "full" (w = H**2 with the bed slope
                                               ! by a fixed point; does not converge on 32 km beds)
    relax              = 0.5                   ! under-relaxation of the outer ("full") iteration
    warm_frac_max      = 0.1                   ! "full": a warm start only if at most this fraction of the ice cells is new
    n_outer            = 100                   ! maximum outer iterations ("full")
    max_sweeps         = 200                   ! maximum fast sweeps per eikonal solve
    tol                = 1.0e-6                ! [m2] sweep tolerance (change of w = H**2)
    outer_tol          = 1.0e-3                ! [m] outer tolerance (change of H)
    rho_i              = 910.0                 ! [kg m-3] ice density: the kryos Earth constants and the PaleoMIST runs (910);
                                               ! the library default is 917 (a value other than the run's rho_ice is logged)
    rho_w              = 1028.0                ! [kg m-3] sea-water density (kryos rho_sw; library default 1025)
    g                  = 9.81                  ! [m s-2] (kryos g; library default 9.80665)
    H_min              = 1.0                   ! [m] floor of H inside the mask (keeps sqrt(w) regular)
    ! margin chronology: slices of an ice fraction or thickness (x, y, time) on the instance grid
    margin_file        = ""                    ! required; {domain}, {grid_name} replaced (as recon_path); its time axis
                                               ! "years ago" / "BP" / "ka ..." is converted to model time
    margin_var         = "f_ice"               ! the variable: "f_ice" (PaleoMIST: ice fraction of the unsmoothed 5 km
                                               ! grid, Gowan's margin) | "H_ice" (smoothed 25 km: reaches beyond it)
    margin_H_min       = 0.5                   ! ice where the slice's margin_var exceeds this (f_ice: 0.5; H_ice: 1 m)
    margin_interp      = "sdist"               ! "sdist": signed distance to the margin, linear between the slices |
                                               ! "nearest": the nearest slice (Gowan et al. 2021 offline)
    margin_extrapolate = "error"               ! outside the slices' (and the tau_b series') time range: "error" | "hold"
    margin_position    = "sdist"               ! the margin within the cells (library margin_frac): "sdist" (from the
                                               ! interpolated signed distance: the faces at the slices, moving between
                                               ! them) | "face" | "centre" (the ice-free cell centre, PlasticIceSheet.jl)
    ! tau_b (drive = "taub")
    taub_method        = "const"               ! "const" | "file" | "domains"
    taub_const         = 0.0                   ! [Pa] "const": the value (> 0)
    taub_file          = ""                    ! "file": a static field (x, y) on the instance grid ({domain}, {grid_name})
    taub_var           = "taub"                ! "file": its variable
    taub_domain_file   = ""                    ! "domains": the product {grid_name}_IceHistory-PaleoMIST_taub.nc ({domain}, {grid_name})
    taub_domain_var    = "taub_domain"         ! "domains": the domain id of each cell (x, y), <= 0 = none (product: -9999)
    taub_id_var        = "domain_id"           ! "domains": the ids (n)
    taub_value_var     = "taub"                ! "domains": their tau_b [Pa] (n)
    taub_time_var      = "taub_t"              ! "domains": their series [Pa] (n, time), used when the file has it (PaleoMIST
                                               ! 1.0: time dependent, linear between its slices)
    taub_override      = ""                    ! "domains": group of a table (codes, taub [Pa]) overriding the value of
                                               ! those ids, constant in time; "" = none
    taub_default       = 0.0                   ! [Pa] "domains": cells without a domain; 0 = none (such a cell in the
                                               ! ice mask stops the run)
    taub_domain_factor_file = ""               ! "domains": a factor per domain id, constant in time, before the scale
                                               ! groups (domain_id, log_factor; the present-day fit,
                                               ! tests/plastic_taub_fit.f90; {domain}, {grid_name}); "" = none
    taub_scale_file    = ""                    ! "domains": multipliers of tau_b per scale group, time dependent (the
                                               ! calibration, tools/levante/plastic_esmda.jl; {domain}, {grid_name});
                                               ! "" = none
    taub_smooth_km     = 50.0                  ! [km] drive = "taub": Gaussian sd of the smoothing of tau_b (after the
                                               ! factors) over the cells with tau_b > 0, for the solve and the
                                               ! closure alike; 0 = none
    ! rheology and sliding (drive = "smb"; mass_balance = "implied")
    rheo_A             = 0.0                   ! [Pa-n yr-1] Glen rate factor; 0 = no velocity
    rheo_n             = 3.0                   ! Glen exponent
    slide_law          = "none"                ! "none" | "linear" | "weertman" | "coulomb" (regularised) | "yield" |
                                               ! "coulomb_n" (regularised Coulomb, C from tau_b, the bed and N)
    slide_beta         = 0.0                   ! linear [Pa yr m-1], weertman [Pa (yr m-1)^(1/m)]
    slide_m            = 1.0                   ! weertman, coulomb, yield, coulomb_n: stress exponent
    slide_C            = 0.0                   ! [Pa] coulomb: the cap
    slide_u0           = 0.0                   ! [m yr-1] coulomb, coulomb_n: the threshold velocity
    slide_umax         = 0.0                   ! [m yr-1] coulomb, coulomb_n: the speed cap (where tau reaches C); 0 = none
                                               ! (coulomb_n needs one)
    slide_Hc           = 0.0                   ! [m] coulomb_n: C = tau_b lambda N / (rho_i g slide_Hc), N the effective
                                               ! pressure; the ice slides fast where it thins below slide_Hc / lambda
    slide_lambda_min   = 1.0                   ! coulomb_n: lambda at a bed slide_zb0 or lower (1 = no bed dependence)
    slide_zb0          = -500.0                ! [m] coulomb_n: bed above sea level (z_bed - z_sl) of slide_lambda_min
    slide_zb1          = 0.0                   ! [m] coulomb_n: of lambda = 1 (linear between)
    slide_p            = 0.5                   ! coulomb_n: N = rho_i g H (1 - H_f/H)^slide_p (Leguy et al. 2014)
    slide_uy           = 0.0                   ! [m yr-1] yield: u_b = u_y (tau/tau_b)^slide_m, u_y = slide_uy (tau_b/100 kPa)^slide_uy_b
    slide_uy_b         = 0.0                   ! yield: exponent of u_y in tau_b (< 0: faster on weaker beds)
    mass_balance       = "none"                ! "none": smb = cmb = 0 | "implied": the mass balance the geometry needs
                                               ! (dHidt + div q of the steady face fluxes, margin outflow ablated to
                                               ! land, calved to the ocean), smb_tot, cmb_tot, ux_s, uy_s (rheo_A, slide_law)
                                               ! | "inverted": speed and mass balance by joint inversion against the
                                               ! closure's speed and the imported smb (the prior; drive = "taub")
    mb_smooth_km       = 0.0                   ! [km] implied: Gaussian sd of the conservative smoothing of div q - q_land
                                               ! over the ice (sums unchanged); 0 = none
    inv_sigma_u        = 0.7                   ! inverted: sd of ln(speed) about the closure's (0.7: a factor 2)
    inv_smooth_km      = 0.0                   ! [km] inverted: length of the smoothness of ln(speed / closure's); 0 = none
    inv_smooth_smb_km  = 50.0                  ! [km] inverted: length of the smoothness of the mass balance's deviation from
                                               ! the prior (a spatially correlated prior error); 0 = none
    inv_sigma_smb_rel  = 0.5                   ! inverted: sd of the mass balance about the prior, relative to |prior|
    inv_sigma_smb_min  = 100.0                 ! [kg m-2 yr-1] inverted: its floor
    inv_cold           = .true.                ! inverted: penalise negative mass balance where the prior is >= 0 (off the margin)
    inv_sigma_cold     = 10.0                  ! [kg m-2 yr-1] inverted: the scale of that penalty
    inv_n_iter         = 50                    ! inverted: Gauss-Newton steps at most
    out_plastic        = "none"                ! schedule of <instance>_plastic.nc (state, mask, sdist, tau_b, ...)
/
&climate_snapshots
    snapshots = "snapshots"
    reference = "pd"
    terms     = ""
/

&climate_paleoemu
    ! The global part (scope global, [globe] climate): the keys labelled global; the regional ports (each domain's
    ! climate): the keys labelled port.
    file      = ""                             ! global: the emulator file (PaleoEmulator scripts/06_emulator.jl)
    reference = ""                             ! global: the pre-industrial reference climate on `grid` (tas_ref, pr_ref,
                                               ! z_srf_ref; PaleoEmulator scripts/prep_kryos_reference.jl)
    beta_p    = 0.0                            ! [K-1] global: precipitation change per kelvin of lapse cooling (lapse rows); 0: the
                                               ! emulator's dlogpr already holds the ice sheets' response (only dtas is at the
                                               ! reference surface)
    beta_adj  = 0.05                           ! [K-1] global: precipitation change per kelvin of the adjustments (scale_dtas, bias)
    scale_dtas = 1.0                           ! global: the emulator's temperature anomaly dtas times this
    bias       = ""                            ! global: the bias correction file ("" none; PaleoEmulator scripts/prep_bias_pmip4.jl,
                                               ! kryos_data/paleoemu/bias), weighted by the NH ice volume
    bias_scale = 1.0                           ! global: the bias correction times this
    scale_dto  = 1.0                           ! global: the ocean temperature change dto_lev = scale_dto dto + dto_nsd dto_sd
    dto_nsd    = 0.0                           ! global: (the emulator's annual ocean T change and its standard deviation)
    filter_start = "training"                  ! global: the emulator's slow filters (CO2, ice volume) at a cold start:
                                               ! "training" = the run's inputs + the lag of CESM-3Ma's trajectory at that
                                               ! time (its deglacial memory at 0 ka: anomalies ~0 at present day;
                                               ! equilibrium outside 0-3 Ma), "equilibrium" = the run's inputs
    out_emu   = "none"                         ! global: schedule of <instance>_emu.nc (the emulator on the CESM grid)
    to_ref    = ""                             ! port: the present-day ocean temperature on the port's grid, a var_defs group
                                               ! (as a snapshot's `to`, e.g. ismip7_to); "" = no ocean (no set A)
    so_ref    = ""                             ! port: the present-day salinity, a var_defs group (with to_ref; e.g. ismip7_so)
    dto_basins = ""                            ! port: basin set of the domain's regions (e.g. "Zwally2012"; extended over the
                                               ! domain by nearest neighbour): dto_ann is each basin's mean over its sampled
                                               ! cells (a basin without any: over its ocean cells of the reference topography,
                                               ! z_bed < 0 and not grounded); "" = the cells' own values
    dto_sample = "zone:shelf_break_buffer"     ! port: the cells each basin's mean samples (a regions selection; default the
                                               ! ocean at the shelf break: the zone between continental shelf and open ocean)
/

&surface_chion
    surface_chion = "surface_chion"            ! host group
    chion         = "chion"
    out_seb       = "none"                     ! schedule of <instance>_seb.nc: BESSI's monthly surface energy balance
                                               ! (swd, swn, lwd, lwn, shf, lhf, prh [W m-2], alb, tsrf, melt) of the last annual cycle
/

&surface_smb_simple
    smb_simple = "smb_simple"                  ! parameter group (schema: &smb_simple at the end of this file)
/

&shelf_marine_shelf
    marine_shelf = "marine_shelf"
    corr         = "shelf_corr"                ! the shelf component's group of the thermal-forcing corrections and basins (kryos_shelf_ocean):
                                               ! basins, corr_method, corr_names, corr_values, corr_<name>, tf_correction, tf_path, tf_name
/

&geothermal_data
    Q_geo     = ""                             ! field group of Q_geo [W m-2]
    Q_geo_min = 0.0                            ! [W m-2] floor after the fill
/

&sediments_data
    H_sed = ""                                 ! field group of H_sed [m]
/

! ===== Backend physics groups kryos owns (no library defaults file) =====

&orbit
    ! The orbit of the run, resolved by the forcing ([forcing_tsgen] orbit) and exported to every component that
    ! takes it (the climate, the surface's insolation); fesmc/insol, Laskar et al. 2004 tables.
    method = "fixed_time"   ! forcing_time: at the forcing time time_rel; fixed_time: at time; fixed_orbit: ecc, obl, per
    time   = 0.0            ! [yr] model time of the orbit (fixed_time; relative to 1950, past < 0)
    ecc    = 0.016725       ! [1]   eccentricity (fixed_orbit; these: the tables at 1950)
    obl    = 23.4458        ! [deg] obliquity (fixed_orbit)
    per    = 102.063        ! [deg] longitude of perihelion (fixed_orbit; Berger 1978)
    fldr   = "input"        ! folder of the orbital tables (LA2004.INSOLN.5Ma.txt, LA2004.INSOLP.1Ma.txt)
/

! ===== The globe's ice field (phase 4, kryos_globe_ice) =====

&globe_ice
    ! The background X and the external ice of the global ice field (phase4-plan 3.4, 4.1, 5.2).
    ! z_bed_ref, H_ice_ref, ext_field name datasrc field groups (input/datasrc_defaults.nml) of the
    ! globe, on `grid`; X is read at ext_tref. The history group is the anomaly against its own
    ! slice: mode = "transient", anomaly_ref = "slice", ref_time = ext_tref, out_of_range = "error"
    ! (the gather holds it after ext_tref); the file's time units ("years ago", "years BP") are read as they are.
    grid        = ""                           ! required: background grid, e.g. "GLOBAL-0.5DEG"
    z_bed_ref   = ""                           ! required: field group of the background bed X [m]
    H_ice_ref   = ""                           ! required: field group of the background ice X [m]
    target      = ""                           ! without geo = vilma2 (observer): the global grid of the host terms (map folder)
    ext         = "ref"                        ! "ref" | "file": ice outside the footprints (X, or X + history anomaly)
    ext_field   = ""                           ! ext = "file": field group of the history H_ice (anomaly)
    ext_tref    = 0.0                          ! [yr] model time of the history's present day (X, anomaly reference)
    overlap_tol = 0.01                         ! coverage of the host region above 1 + overlap_tol stops (overlapping domains)
    cons_tol    = 1.0e-9                       ! relative closure of the merges above which a gather stops
    out_2D      = "none"                       ! schedule of globe_ice.nc (the hub output)
/

&smb_simple
    ! The synthetic-elevation SMB scheme of the surface backend smb_simple (yelmox
    ! libs/smb_simple.f90, group [smb_simple]). SMB in mm w.e./yr. The defaults are the
    ! module's own; a par file of a science configuration lists the tuned keys.
    scheme       = "syn"        ! synthetic-elevation piecewise-linear; "tg24" is not implemented
    co2_const    = 280.0        ! [ppm]   constant CO2 (affects the snow line only if a3 /= 0)
    f_const      = 494.5        ! [W m-2] constant insolation (only if a4 /= 0)
    mask_file    = ""           ! target ice-mask file ("" => H_ice_ref > 0; {domain}, {grid_name} = the surface grid)
    mask_var     = ""           ! mask variable of mask_file
    mask_idx     = 1            ! index along the third dimension of mask_var
    mask_ice     = False        ! True: the mask is the current ice (H_ice > 0 of the hub) every call (an ice
                                ! backend whose H_ice_ref is a fixed reference, e.g. plastic); not with mask_file
    tsl_const    = -1.0         ! [K] > 0: a constant sea-level temperature instead of the tsl_ann import (a
                                ! domain without a climate; only T_srf uses it); <= 0: tsl_ann is imported

    ! Climate snow line  z_SL = a1 + a2*phi + a3*CO2 + a4*(f - fmean), phi = |latitude|
    a1           = 3750.0       ! [m]
    a2           = -50.0        ! [m/degN]
    a3           = 0.0          ! [m/ppm]
    a4           = 0.0          ! [m/(W m-2)]
    fmean        = 494.5        ! [W m-2]

    ! Ablation lapse rate  beta = max(beta_floor, beta0 + beta1*(phiref - phi))
    beta0        = 4.0          ! [(mm/yr)/m] at phiref
    beta1        = 0.05         ! [(mm/yr)/m] per degN
    phiref       = 60.0         ! [degN]
    beta_floor   = 0.0          ! [(mm/yr)/m]

    ! Accumulation  acc = c0 * f_lat(phi) * f_dist(d_in)
    !   f_dist = exp(-d_in_km / L_acc), f_lat = clamp(1 - k_acc_lat*max(0, phi - phi_acc_ref), facc_lat_min, 1)
    c0           = 150.0        ! [mm w.e./yr] accumulation at the margin
    L_acc        = 1000.0       ! [km] e-folding length of the inland decay
    k_acc_lat    = 0.0          ! [1/degN] (0 = off)
    phi_acc_ref  = 0.0          ! [degN]
    facc_lat_min = 0.3          ! [1]

    ! Synthetic elevation profile
    use_plastic  = True         ! True: plastic Nye/Vialov inside; False: linear wedge (slope)
    slope        = 6.09e-3      ! [m/m] inside (use_plastic = False)
    tau0         = 36.0e3       ! [Pa] plastic basal yield stress
    slope_out    = 6.09e-3      ! [m/m] outside ramp
    z_max_in     = 2500.0       ! [m] inside cap
    z_max_out    = 200.0        ! [m] outside floor

    ! Surface temperature  t_srf = t_sl - gamma_t*max(z_syn, 0), capped at t_ice_max over ice
    gamma_t      = 6.5e-3       ! [K/m]
    t_ice_max    = 273.15       ! [K]
    smb_min      = -2000.0      ! [mm w.e./yr] floor outside the mask (<= 0)
/
