! kryos par file: Gowan et al. (2021) PaleoMIST online, smoke run on a fixed bed (docs/dev/plastic-backend.md).
! Domain North (NH-32KM) with one instance, ice = plastic: the PaleoMIST margins (minimal MIS 3 scenario, 2.5 kyr
! slices from 80 ka), interpolated by the signed distance, tau_b constant until the FesmData product
! {GRID}_TauB-Gowan2021.nc is released (then taub_method = "domains", keys below), no geo: the bed is today's
! (FesmData TOPO-GEBCO2026, the reference) and z_sl = 0. No globe, no climate: the plastic ice needs neither.
! The geo = vilma2 variant: par/kryos_North_plastic_vilma2.nml. Keys left out take the templates of
! input/kryos_defaults.nml. Build: plastic=1 (yelmo=0 is enough).
!   runme / kryos.x par/kryos_North_plastic.nml          (-p clock.time_end=<t> for a shorter run)

&kryos
    domains         = "North"
    clock           = "clock"
    restart         = "None"
    restart_out     = "out_rst"
    out_dir         = "./"
    map_fldr        = "maps"
    phys_const      = "Earth"                ! rho_ice 910, rho_sw 1028, g 9.81: the plastic keys below equal them
    phys_const_file = "input/phys_const.nml"
    write_lossless  = False
    log_level       = "info"
    timing          = True
/

&clock
    time_init      = -80e3     ! [yr] the first PaleoMIST slice (80 ka)
    time_end       = 0.0       ! [yr] present day
    dtt            = 100.0     ! [yr] one plastic solve per 100 yr (PaleoMIST: 2.5 kyr slices)
    method         = "rel"
    time_ref       = 1950.0
    calendar       = "365_day"
    year           = "tropical"
    ticks_per_year = 36000
/

&out_1D
    method = "const"
    dt     = 100.0
/

&out_2D
    method = "const"
    dt     = 2500.0            ! [yr] the PaleoMIST slice times (comparison with H_ice of the history)
/

&out_rst
    method = "const"
    dt     = 10e3
/

&North
    grid_hub    = "NH-32KM"
    topo        = "topo_nor"
    regions     = "regions_nor"
    basins      = "domain"
    out_2D      = "none"
    ice         = "ice_nor"
/

&ice_nor
    backend            = "plastic"
    grid               = ""             ! the hub grid, NH-32KM
    dt                 = 0.0            ! every step
    phase              = 0.0
    clock              = "model"
    out_2D             = "out_2D"
    out_1D             = "out_1D"
    out_vars           = ""
    drive              = "taub"
    mode               = "flat"         ! "full" does not converge on 32 km beds (library docs)
    relax              = 0.5
    warm_frac_max      = 0.1
    n_outer            = 100
    max_sweeps         = 200
    tol                = 1.0e-6
    outer_tol          = 1.0e-3
    rho_i              = 910.0          ! kryos Earth / PaleoMIST runs (library default 917)
    rho_w              = 1028.0
    g                  = 9.81
    H_min              = 1.0
    margin_file        = "fesmdata/{domain}/{grid_name}/{grid_name}_IceHistory-PaleoMIST.nc"   ! "years ago", 80 -> 0 ka
    margin_var         = "H_ice"
    margin_H_min       = 0.0
    margin_interp      = "sdist"        ! "nearest": Gowan's slices as they are
    margin_extrapolate = "error"
    taub_method        = "const"        ! "domains" once fesmdata/.../{grid_name}_TauB-Gowan2021.nc exists
    taub_const         = 1.0e5          ! [Pa] uniform (smoke run only)
    taub_domain_file   = "fesmdata/{domain}/{grid_name}/{grid_name}_TauB-Gowan2021.nc"
    taub_domain_var    = "taub_domain"
    taub_id_var        = "domain_id"
    taub_value_var     = "taub"
    taub_time_var      = "taub_t"
    taub_override      = ""
    taub_default       = 0.0            ! [Pa] 0: an ice cell outside every domain stops the run
    out_plastic        = "out_2D"       ! ice_nor_plastic.nc: mask, sdist, tau_b, convergence
/

&topo_nor
    path         = "fesmdata/{domain}/{grid_name}/{grid_name}_TOPO-GEBCO2026.nc"
    vars         = "z_bed" "z_srf" "H_ice"
    remap        = "con"
    z_bed_f_sd   = 0.0
    remove_lakes = True
    H_ice_min    = 1.0
    grad_lim_zb  = 0.5
/

&regions_nor
    path_regions = "fesmdata/{domain}/{grid_name}/{grid_name}_REGIONS.nc"
/
