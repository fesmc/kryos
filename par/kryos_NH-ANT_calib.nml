! kryos_NH-ANT_calib.nml: calib-cf variant of kryos_NH-ANT.nml generated by tools/bin/kryos-calib-par.jl sci. Changes: [ytill_ant] scale_zb 0 -> 2, cf_ref 0.1 -> 0.05; [ytill_nor] cf_ref 0.1 -> 0.1; [ycalv_ant] equil -> threshold (as [ycalv_nor] otherwise).
! kryos par file, merged from 2 single-domain files by KryosTools.Convert.merge_par (tools/bin/kryos-merge.jl). Generated: do not edit.
! domains: North, Antarctica (instance suffixes nor, ant)
! from North: kryos_North.nml
!   yelmox commit: 5ac89c80c61e00c0e439fec043413066cc6a87e3 (topo-prep)
!   source: yelmox/yelmox_North.nml
!   -p: (none)
! from Antarctica: kryos_Antarctica.nml
!   yelmox commit: 5ac89c80c61e00c0e439fec043413066cc6a87e3 (topo-prep)
!   source: yelmox/yelmox_Antarctica.nml
!   -p: sim.relax=False sim.opt=False
! resolved clock.time_end = 15e3  (100e3 | 15e3)
! resolved clock.time_const = 0.0  (-21e3 | 0.0)
! resolved barysealevel.sl_path = "none"  ("input/sl_deglaciation.dat" | "none")
! domain-specific groups the files share are renamed with the instance suffix (see the merge report).

&kryos
    domains         = "North" "Antarctica"   ! domain of kryos_North.nml, domain of kryos_Antarctica.nml
    globe           = "globe"
    clock           = "clock"
    restart         = "None"                 ! yelmox ctrl.restart
    restart_out     = "out_rst"
    out_dir         = "./"
    map_fldr        = "maps"
    phys_const      = "Earth"                ! yelmox domain.phys_const
    phys_const_file = "input/phys_const.nml"
    library         = ""
    write_lossless  = False                  ! yelmox ctrl.write_lossless
    log_level       = "info"
    timing          = True
/

&clock
    time_init      = 0.0       ! yelmox ctrl.time_init
    time_end       = 15e3      ! resolved: kryos_North.nml 100e3, kryos_Antarctica.nml 15e3
    dtt            = 10.0      ! yelmox ctrl.dtt
    method         = "const"   ! yelmox ctrl.tstep_method
    time_ref       = 1950.0    ! yelmox ctrl.calendar_ref
    calendar       = "365_day"
    year           = "tropical"
    ticks_per_year = 36000
    time_const     = 0.0       ! resolved: kryos_North.nml -21e3, kryos_Antarctica.nml 0.0
/

&out_1D
    method = "const"                                                             ! yelmox tm_1D.method
    dt     = 10.0                                                                ! yelmox tm_1D.dt = 1.0 raised to dtt
    times  = -10, -5, 0, 1, 2, 3, 4, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55   ! yelmox tm_1D.times
    file   = "input/timeout_ramp_100kyr.txt"                                     ! yelmox tm_1D.file
/

&out_2D
    method = "const"                           ! yelmox tm_2D.method
    dt     = 200.0                             ! yelmox tm_2D.dt
    times  = 0                                 ! yelmox tm_2D.times
    file   = "input/timeout_ramp_100kyr.txt"   ! yelmox tm_2D.file
/

&out_2Dsm
    method = "const"                           ! yelmox tm_2Dsm.method
    dt     = 50.0                              ! yelmox tm_2Dsm.dt
    times  = 0                                 ! yelmox tm_2Dsm.times
    file   = "input/timeout_ramp_100kyr.txt"   ! yelmox tm_2Dsm.file
/

&out_rst
    method = "const"                           ! yelmox tm_rst.method
    dt     = 20e3                              ! yelmox tm_rst.dt
    times  = 0                                 ! yelmox tm_rst.times
    file   = "input/timeout_ramp_100kyr.txt"   ! yelmox tm_rst.file
/

&globe
    forcing = "forcing"
    geo     = "geo_glob"
/

&forcing
    backend  = "tsgen"
    grid     = ""
    dt       = 0.0
    phase    = 0.0
    clock    = "forcing"
    out_2D   = "none"
    out_1D   = "out_1D"        ! yelmox output.write_yelmo
    out_vars = ""
    coefs    = "alpha" "dTo"   ! the union of the coefficients of the files
/

&geo_glob
    backend     = "fastisostasy"
    grid        = ""
    dt          = 0.0
    phase       = 0.0
    clock       = "forcing"
    out_2D      = "none"
    out_1D      = "out_1D"   ! yelmox output.write_isos
    out_vars    = ""
    bsl         = "barysealevel"
    out_isos    = "none"
    out_isos_ts = "none"
    out_bsl_ts  = "out_1D"   ! yelmox output.write_isos
/

&barysealevel
    method       = "fastiso"                                                      ! "const": BSL = bsl_init throughout sim
    bsl_init     = 0.0                                                            ! [m] BSL relative to present day
    sl_path      = "none"                                                         ! resolved: kryos_North.nml "input/sl_deglaciation.dat", kryos_Antarctica.nml "none"
    sl_name      = "none"                                                         ! Variable name in netcdf file, if relevant
    A_ocean_pd   = 3.625e14                                                       ! [m^2] Ocean surface as in Goelzer et al. (2020)
    A_ocean_path = "isostasy_data/tools/ocean_surface/OceanSurfaceETOPO2022.nc"   ! Path to ocean surface file
    restart      = "None"                                                         ! Path to restart file
/

&coef_alpha
    method           = "const"   ! const|ramp-slope|ramp-time|ramp-time-step|sin|series|exp|PI42|H312b|H312PID|H321PID|PID1|derived
    sigma            = 0.0       ! [f] std. dev. of gaussian noise added to the coefficient
    series_file      = ""        ! table (time, f) or netcdf file of the series
    series_var       = ""        ! variable of a netcdf series_file
    series_time_name = "time"    ! its time variable
    norm_t0          = 0.0       ! [yr] normalise: f = (S - S(t0))/(S(t1) - S(t0)), t one time or a window t0 t1 (the mean);
    norm_t1          = 0.0       ! [yr]   only when both are set in the par group (the values here are not used)
    with_kill        = False     ! stop the run once the response equilibrates at a bound
    dt_init          = 0.0       ! [yr] hold the forcing flat during this initial interval
    dt_ramp          = 1000.0    ! [yr] ramp/period length (ramp-time, ramp-time-step, sin)
    dt_conv          = 1000.0    ! [yr] convergence interval (ramp-time-step)
    dt_ave           = 100.0     ! [yr] averaging window of the response derivative (feedback, kill)
    df_sign          = 1.0       ! +1/-1 direction of the forcing change
    tol              = 1.0       ! response-rate tolerance (feedback, kill)
    df_dt_max        = 0.0       ! [f/yr] forcing rate (const/ramp-slope; maximum for feedback)
    f_min            = 1.0       ! [f] lower bound; the value of const (f_min + df_dt_max*t, clamped)
    f_max            = 1.0       ! [f] upper bound
    f_conv           = 0.0       ! [f] value held after convergence (ramp-time-step)
    from             = ""        ! air_anomaly: factor * mean sea-level air anomaly of the climate update over region;
    factor           = 1.0       ! [1] air_anomaly: value = factor * mean(tsl_ann - tsl_ann_ref)
    region           = "all"     ! air_anomaly: cells of the mean: "all" or a [regions] selection, e.g. "zone:open_ocean"
    anomaly          = True      ! obm_*: the box temperature minus its initial value (False: the temperature itself)
    units            = "1"       ! units label of coef_<name> in the 1D output
    restart_every_df = 0.0       ! [f] write a restart each time f moves by this much; 0 = off
    win_t0           = 0.0       ! [yr] window start
    win_t1           = 0.0       ! [yr] window end
    win_taper        = 0.0       ! [yr] ramp width inside the window edges
    win_fac          = 1.0       ! [1] factor on f - win_ref inside the window
    win_ref          = 0.0       ! [f] reference value of the scaling
    win_above        = False     ! apply only where f > win_ref
/

&coef_dTo
    method           = "derived"       ! const|ramp-slope|ramp-time|ramp-time-step|sin|series|exp|PI42|H312b|H312PID|H321PID|PID1|derived
    sigma            = 0.0             ! [f] std. dev. of gaussian noise added to the coefficient
    series_file      = ""              ! table (time, f) or netcdf file of the series
    series_var       = ""              ! variable of a netcdf series_file
    series_time_name = "time"          ! its time variable
    norm_t0          = 0.0             ! [yr] normalise: f = (S - S(t0))/(S(t1) - S(t0)), t one time or a window t0 t1 (the mean);
    norm_t1          = 0.0             ! [yr]   only when both are set in the par group (the values here are not used)
    with_kill        = False           ! stop the run once the response equilibrates at a bound
    dt_init          = 0.0             ! [yr] hold the forcing flat during this initial interval
    dt_ramp          = 1000.0          ! [yr] ramp/period length (ramp-time, ramp-time-step, sin)
    dt_conv          = 1000.0          ! [yr] convergence interval (ramp-time-step)
    dt_ave           = 100.0           ! [yr] averaging window of the response derivative (feedback, kill)
    df_sign          = 1.0             ! +1/-1 direction of the forcing change
    tol              = 1.0             ! response-rate tolerance (feedback, kill)
    df_dt_max        = 0.0             ! [f/yr] forcing rate (const/ramp-slope; maximum for feedback)
    f_min            = 0.0             ! [f] lower bound; the value of const (f_min + df_dt_max*t, clamped)
    f_max            = 1.0             ! [f] upper bound
    f_conv           = 0.0             ! [f] value held after convergence (ramp-time-step)
    from             = "air_anomaly"   ! air_anomaly: factor * mean sea-level air anomaly of the climate update over region;
    factor           = 0.25            ! [1] air_anomaly: value = factor * mean(tsl_ann - tsl_ann_ref)
    region           = "all"           ! air_anomaly: cells of the mean: "all" or a [regions] selection, e.g. "zone:open_ocean"
    anomaly          = True            ! obm_*: the box temperature minus its initial value (False: the temperature itself)
    units            = "K"             ! units label of coef_<name> in the 1D output
    restart_every_df = 0.0             ! [f] write a restart each time f moves by this much; 0 = off
    win_t0           = 0.0             ! [yr] window start
    win_t1           = 0.0             ! [yr] window end
    win_taper        = 0.0             ! [yr] ramp width inside the window edges
    win_fac          = 1.0             ! [1] factor on f - win_ref inside the window
    win_ref          = 0.0             ! [f] reference value of the scaling
    win_above        = False           ! apply only where f > win_ref
/

&North
    grid_hub    = "NH-32KM"   ! yelmox domain.grid_hub
    topo        = "topo_nor"
    regions     = "regions_nor"
    basins      = "domain"    ! yelmox domain.basins
    out_2D      = "out_2D"    ! yelmox output.write_htopo
    ice         = "ice_nor"
    geo         = "geo_nor"
    climate     = "climate_nor"
    surface     = "surface_nor"
    shelf       = "shelf_nor"
    geothermal  = "ghf_nor"
    sediments   = "sed_nor"
    experiments = "recon_nor"
/

&ice_nor
    backend         = "yelmo"
    grid            = ""           ! yelmox domain.grid_ice
    dt              = 0.0
    phase           = 0.0
    clock           = "model"
    out_2D          = "out_2D"     ! yelmox output.write_yelmo
    out_1D          = "out_1D"     ! yelmox output.write_yelmo
    out_vars        = ""
    yelmo           = "yelmo_nor"
    init_equil_time = 0.0          ! yelmox sim.init_method = none
    init_time_thrm  = 0.0          ! yelmox sim.init_time_thrm
    out_yelmo       = "out_2D"     ! yelmox output.write_yelmo
    out_yelmo_sm    = "out_2Dsm"   ! yelmox output.write_yelmo
    out_yelmo_ts    = "out_1D"     ! yelmox output.write_yelmo
/

&geo_nor
    backend     = "fastisostasy"
    grid        = "NH-32KM"   ! yelmox domain.grid_isos
    dt          = 10.0        ! yelmox comps.dt_isos
    phase       = 0.0
    clock       = "model"
    out_2D      = "out_2D"    ! yelmox output.write_isos
    out_1D      = "out_1D"    ! yelmox output.write_isos
    out_vars    = ""
    isos        = "isos_nor"
    out_isos    = "out_2D"    ! yelmox output.write_isos
    out_isos_ts = "out_1D"    ! yelmox output.write_isos
    out_bsl_ts  = "none"
/

&climate_nor
    backend   = "snapshots"     ! yelmox comps.climate
    grid      = "NH-32KM"       ! yelmox domain.grid_clim
    dt        = 10.0            ! yelmox comps.dt_clim
    phase     = 0.0
    clock     = "forcing"
    out_2D    = "out_2D"        ! yelmox output.write_clim
    out_1D    = "none"
    out_vars  = ""
    snapshots = "snapshots_nor"
    reference = "pd_nor"        ! yelmox forcing.reference
    terms     = "lgm" "ocean"   ! yelmox forcing.terms
/

&surface_nor
    backend       = "chion"     ! yelmox comps.surface_method
    grid          = "NH-32KM"   ! yelmox domain.grid_surface
    dt            = 0.0
    phase         = 0.0
    clock         = "forcing"
    out_2D        = "out_2D"    ! yelmox output.write_surface
    out_1D        = "none"
    out_vars      = ""
    surface_chion = "surface_chion_nor"
    chion         = "chion_nor"
    orbit         = "orbit_nor"
/

&shelf_nor
    backend      = "marine_shelf"
    grid         = "NH-32KM"   ! yelmox domain.grid_shelf
    dt           = 0.0
    phase        = 0.0
    clock        = "model"
    out_2D       = "out_2D"    ! yelmox output.write_shelf
    out_1D       = "none"
    out_vars     = ""
    marine_shelf = "marine_shelf_nor"
    corr         = "shelf_corr_nor"
/

&ghf_nor
    backend   = "data"
    grid      = ""
    dt        = -1.0
    phase     = 0.0
    clock     = "model"
    out_2D    = "none"
    out_1D    = "none"
    out_vars  = ""
    Q_geo     = "Q_geo_nor"
    Q_geo_min = 0.0001
/

&sed_nor
    backend  = "data"
    grid     = ""
    dt       = -1.0
    phase    = 0.0
    clock    = "model"
    out_2D   = "none"
    out_1D   = "none"
    out_vars = ""
    H_sed    = "H_sed_nor"
/

&Q_geo_nor
    filename     = "fesmdata/{domain}/{grid_name}/{grid_name}_GHF-Shapiro2004.nc"
    name         = "ghf"
    mode         = "static"
    value        = 0.0
    time_method  = "auto"
    out_of_range = "error"
    units        = "auto" "auto"
    scaling      = 1.0 0.0
    remap        = "auto"
    grid_src     = ""
    fill         = "nearest"
    fill_value   = 0.0
    anomaly_ref  = "none"
    ref_time     = 0.0
    ref_group    = ""
    time         = -1 0 0 0 0
    time_units   = ""
    calendar     = ""
/

&H_sed_nor
    filename     = "fesmdata/{domain}/{grid_name}/{grid_name}_Sediment-CRUST1.nc"
    name         = "z_sed"
    mode         = "static"
    value        = 0.0
    time_method  = "auto"
    out_of_range = "error"
    units        = "auto" "auto"
    scaling      = 1.0 0.0
    remap        = "auto"
    grid_src     = ""
    fill         = "nearest"
    fill_value   = 0.0
    anomaly_ref  = "none"
    ref_time     = 0.0
    ref_group    = ""
    time         = -1 0 0 0 0
    time_units   = ""
    calendar     = ""
/

&recon_nor
    kind          = "recon"
    recon_path    = "ice_data/{domain}/{grid_name}/{grid_name}_TOPO-ICE-6G_C.nc"   ! yelmox sim.recon_path
    recon_var     = "dz"                                                           ! yelmox sim.recon_var
    recon_time    = -26e3                                                          ! yelmox sim.recon_time
    recon_regions = "region:North_America"                                         ! yelmox sim.recon_regions
/

&topo_nor
    path         = "fesmdata/{domain}/{grid_name}/{grid_name}_TOPO-GEBCO2026.nc"
    vars         = "z_bed" "z_srf" "H_ice"
    remap        = "con"
    z_bed_f_sd   = 0.0    ! Preparation of the reference (hub): z_bed = z_bed + f_sd*z_bed_sd
    remove_lakes = True   ! Remove englacial lakes (sea level 0)
    H_ice_min    = 1.0    ! [m] Remove ice thinner than this
    grad_lim_zb  = 0.5    ! [m/m] Limit the bed gradient (dzb/dx)
/

&regions_nor
    path_regions = "fesmdata/{domain}/{grid_name}/{grid_name}_REGIONS.nc"
/

&isos_nor
    heterogeneous_ssh        = .true.        ! Sea level varies spatially?
    interactive_sealevel     = .true.        ! Sea level interacts with solid Earth deformation?
    include_elastic          = .true.        ! Include elastic deformation?
    correct_compression      = .true.        ! Account for compression effects on relaxation time?
    correct_distortion       = .false.       ! Account for distortion of projection?
    method                   = 3             ! 0: constant displacement; 1: LLRA; 2: LV-ELRA, 3: LV-ELVA
    dt_diagnostics           = 10.           ! [yr] Min. timestep to recalculate diagnostics
    pad                      = 512.          ! [km] Padding around domain (preferably chosen as a power
    mantle                   = "uniform"     ! Choose mantle viscosity field, options:
    lithosphere              = "uniform"     ! Choose lithospheric thickness field:
    layering                 = "equalized"   ! "parallel" or "equalized"
    lumping                  = "min"         ! "bottom", "min", "max", "mean", "logmean", "freqdomain"
    viscosity_scaling_method = "none"        ! "scale" or "min" or "max"
    viscosity_scaling        = 1.            ! Only used if viscosity_scaling_method = "scale"
    nl                       = 1             ! [1] Number of viscous layers for sub-lithospheric mantle
    zl                       = 88.           ! [km] Depth of layer boundaries. The first value is overwritten
    viscosities              = 1.e21         ! [Pa s] Layer viscosities. Only used if
    ref_viscosity            = 1.e21         ! [Pa s] Reference viscosity for scaling
    tau                      = 3000.0        ! [yr] Relaxation time used for "method" = 2
    litho_thickness_scaling  = 1.0           ! Scaling factor for lithospheric thickness. Only used if lithosphere = "rheology_file"
    E                        = 66.0          ! [GPa] Young modulus
    nu                       = 0.28          ! [-] Poisson ratio
    rho_litho                = 3200.0        ! [kg/m^3]  If 0: decouple the elastic displacement from the viscous one
    r_earth                  = 6.378e3       ! [km]  Earth radius, Coulon et al. (2021)
    m_earth                  = 5.972e24      ! [kg] Earth mass,   Coulon et al. (2021)
    restart                  = "None"
    mask_file                = "None"
    rheology_file            = "None"
    dt_method                = "tsit54"      ! Time stepping method, options: "euler", "rk4", "bs32", "tsit54"
    dt_init                  = 1.0           ! [yr] Initial time step for time stepping method. If dt_method
    dt_min                   = 1e-10         ! [yr] Minimum dt. Only used if dt_method is "bs32" or "tsit54".
    dt_max                   = 10.0          ! [yr] Maximum dt. Only used if dt_method is "bs32" or "tsit54".
    rtol                     = 1e-4          ! Relative tol. Only used if dt_method is "bs32" or "tsit54".
    atol                     = 1e-2          ! Absolute tol. Only used if dt_method is "bs32" or "tsit54".
    q                        = 1.0           ! Exponent for dt adaptation. The higher the most conservative the time stepping.
/

&snapshots_nor
    grid_global = "GLOBAL-1DEG"               ! global grid of the paleoclimate products ({grid_global})
    fields      = "tas" "pr" "to" "so" "zs"   ! the fields a snapshot may bind
    lapse       = 0.0080 0.0065               ! [K m-1] lapse rates: annual, summer
    f_p         = 0.05                        ! [K-1] precipitation-temperature scaling (beta_p)
/

&orbit_nor
    method = "fixed_time"   ! forcing_time: at the forcing time; fixed_time: at time; fixed_orbit: ecc, obl, per
    time   = 0.0            ! [yr] model time of the orbit (fixed_time; relative to 1950, past < 0)
    ecc    = 0.016702       ! [1]   eccentricity (fixed_orbit; these: the tables at 1950)
    obl    = 23.4393        ! [deg] obliquity (fixed_orbit)
    per    = 102.918        ! [deg] longitude of perihelion (fixed_orbit)
    fldr   = "input"        ! folder of the orbital tables (LA2004.INSOLN.5Ma.txt, LA2004.INSOLP.1Ma.txt)
/

&surface_chion_nor
    sf_a       = 0.273   ! Snow fraction function (parameter a)
    sf_b       = 273.6   ! Snow fraction function (parameter b)
    sigma_pdd  = 5.0     ! [K] Temperature standard deviation for the annual PDDs (itm)
    time_equil = 100.0   ! [yr] Cold-start snowpack spin-up (annual cycles)
    dt_days    = 1       ! [d] chion step (divides the 360-day year)
    trans_sw   = 0.6     ! [1] TOA -> surface shortwave transmissivity (bessi)
    wind_speed = 5.0     ! [m s-1] Constant wind speed (bessi)
    rel_hum    = 0.8     ! [1] Constant relative humidity (bessi)
/

&chion_nor
    model           = "pdd"                          ! Snowpack model: "itm", "bessi" or "pdd"
    nml_bessi       = "bessi"                        ! Namelist group holding the BESSI parameters
    nml_pdd         = "pdd_chion_nor"                ! PDD parameters (chion's own group)
    nml_itm         = "itm"                          ! Namelist group holding the ITM parameters
    nml_const       = "chion_const_nor"              ! Namelist group holding chion's own constants
    phys_const_file = "input/chion_phys_const.nml"   ! Shared constants, standalone only
    phys_const      = "Earth"                        ! Group within phys_const_file
    restart         = "None"                         ! Restart file, or "None" for a cold start (WP14)
/

&chion_const_nor
    rho_s                              = 315.0           ! [kg m-3] Fresh snow density (constant scheme)
    rho_s_a                            = 109.0           ! [kg m-3] Intercept
    rho_s_b                            = 6.0             ! [kg m-3 K-1] Temperature slope
    rho_s_c                            = 26.0            ! [kg m-3 (m s-1)^-1/2] Wind slope
    fresh_snow_density_scheme          = "constant"      ! "constant" | "parameterized"
    Lv                                 = 2.501e6         ! [J kg-1] Latent heat of vaporization
    cp_air                             = 1003.0          ! [J kg-1 K-1] Heat capacity of air
    latent_heat_flux_ratio             = 1.0             ! [1] Scaling of the turbulent latent flux
    seb_scheme                         = "semix"         ! Longwave only: "bessi" | "semix" (absorbed with eps_snow / eps_ice)
    turbulent_flux_scheme              = "semix"         ! Sensible and latent heat: "bessi" | "semix" | "climberx"
    D_sh                               = 10.0            ! [W m-2 K-1] Sensible heat exchange coefficient (bessi)
    z0m_snow                           = 0.0024          ! [m]  Momentum roughness length, snow
    z0m_ice                            = 0.002           ! [m]  Momentum roughness length, ice
    zm_to_zh                           = 0.13533528      ! [1]  Heat/momentum roughness ratio, exp(-2)
    z_sfl                              = 100.0           ! [m]  Surface layer height
    karman                             = 0.4             ! [1]  von Karman constant
    R_dry                              = 287.058         ! [J kg-1 K-1] Gas constant of dry air
    l_neutral                          = .FALSE.         ! [1]  Force neutral stratification?
    l_dew                              = .TRUE.          ! [1]  Allow dew/frost deposition?
    climberx_qsat                      = "climberx"      ! Saturation humidity: "climberx" (q_sat_i) | "bessi"
    semix_karman                       = 0.4             ! [1]  von Karman constant
    semix_surface_height               = 10.0            ! [m]  Reference height of air temperature and wind
    semix_z0m_snow                     = 0.001           ! [m]  Momentum roughness length, snow
    semix_z0m_ice                      = 0.01            ! [m]  Momentum roughness length, bare ice
    semix_zm_to_zh                     = 10.0            ! [1]  z0m/z0h
    semix_sensible_exchange_factor     = 2.5             ! [1]  Sensible-heat exchange factor (MAR-calibrated)
    semix_stable_coefficient           = 40.0            ! [1]  b in the stable damping 1/(1 + b*Ri) (MAR-calibrated)
    semix_latent_exchange_factor       = 1.0             ! [1]  Latent-heat exchange factor
    alpha_dry                          = 0.81            ! [1] Dry snow albedo (upper bound)
    alpha_wet                          = 0.70            ! [1] Wet snow albedo (lower bound)
    alpha_ice                          = 0.40            ! [1] Bare ice albedo
    max_lwc_albedo                     = 0.10            ! [1] LWC at which the albedo reaches alpha_wet
    albedo_scheme                      = "dynamic"       ! "constant" | "dynamic" | "prescribed" | "semix" | "aging"
    aging_cold_timescale_days          = 20.0            ! [d] Aging e-folding time, surface below T0 (albedo_scheme = "aging")
    aging_melting_timescale_days       = 2.0             ! [d] Aging e-folding time, surface at T0
    aging_snowfall_ref                 = 10.0            ! [kg m-2] e-folding snowfall of the aging albedo's rejuvenation
    swe_crit_albedo                    = 10.0            ! [kg m-2] Column SWE of full snow cover (0 = off: any snow covers)
    alpha_land                         = 0.2             ! [1] Background albedo of a land column (H_ice = 0)
    c_fsnow                            = 10.0            ! [1] SEMIX snow cover tanh(h_snow/(c_fsnow*z0m_ice)) (CLIMBER-X)
    c_fsnow_orog                       = 2e-4            ! [1] SEMIX orography h_snow/(h_snow + c_fsnow_orog*z_sur_std)
    frac_vu                            = 0.45            ! [1]  Visible+UV fraction of incoming solar
    alb_snow_vis_new                   = 0.99            ! [1]  Fresh-snow visible diffuse albedo
    alb_snow_nir_new                   = 0.65            ! [1]  Fresh-snow near-IR diffuse albedo
    snow_grain_fresh                   = 50.0            ! [um] Fresh snow grain size
    snow_grain_old                     = 1000.0          ! [um] Aged snow grain size
    d_alb_age_vis                      = 0.05            ! [1]  Visible aging albedo reduction
    d_alb_age_nir                      = 0.25            ! [1]  Near-IR aging albedo reduction
    f_age_t                            = 0.1             ! [K-1] Dry-snow temperature aging factor
    dT_age                             = 0.0             ! [K]  Aging temperature offset
    snow_0                             = 1.0             ! [kg m-2 d-1] Critical snowfall rate for grain aging
    snow_1                             = 0.5             ! [1]  Snowfall-rate aging exponent
    w_snow_dust                        = 10.0            ! [kg m-2] SWE melt that doubles dust concentration
    dust_con_scale                     = 1.0             ! [1]  Dust concentration scaling
    semix_snow_albedo                  = "dang"          ! "warren_wiscombe" | "dang" (CLIMBER-X default: Dang 2015)
    dalb_snow_vis                      = 0.0             ! [1]  Visible snow albedo offset (Dang)
    dalb_snow_nir                      = 0.0             ! [1]  Near-IR snow albedo offset (Dang)
    k_sigma_orog                       = 0.0             ! [1]  Orographic albedo reduction scale (Dang)
    sigma_orog_crit                    = 1000.0          ! [m]  Orographic roughness scale (Dang)
    eps_air                            = 0.80            ! [1] Emissivity of air (graybody longwave)
    longwave_scheme                    = "cloud_proxy"   ! Downwelling longwave if not prescribed: "graybody" | "cloud_proxy"
    lw_emissivity_base                 = 0.624           ! [1]     Cloud proxy: emissivity at T0, clear sky
    lw_emissivity_temperature_slope    = 0.0032          ! [K-1]   Cloud proxy: emissivity per K of T_air - T0
    lw_emissivity_cloud_slope          = 0.613           ! [1]     Cloud proxy: emissivity per unit cloudiness
    lw_clear_sky_transmissivity        = 0.85            ! [1]     Cloud proxy: clear-sky SW transmissivity at sea level
    lw_clear_sky_transmissivity_per_km = 0.075           ! [km-1]  Cloud proxy: its increase with surface height
    lw_night_cloud_fraction            = 0.389           ! [1]     Cloud proxy: cloudiness without a daily TOA
    eps_snow                           = 0.98            ! [1] Emissivity of snow
    eps_ice                            = 0.98            ! [1] Emissivity of bare ice (seb_scheme = "semix" only)
    sigma_sb                           = 5.670373e-8     ! [W m-2 K-4] Stefan-Boltzmann constant
    low_density_densification          = "bessi"         ! "bessi" | "htessel" (selects the rho<550 branch only)
/

&pdd_chion_nor
    ddf_snow            = 3.0      ! [kg m-2 K-1 d-1] Degree-day factor for snow
    ddf_ice             = 8.0      ! [kg m-2 K-1 d-1] Degree-day factor for ice
    refreezing_fraction = 0.6      ! [1] Refreezing capacity per unit snowpack
    temperature_sigma   = 5.0      ! [K] Std dev of unresolved temperature variability
    H_snow_max          = 5000.0   ! [kg m-2] Snowpack cap; the excess is converted to ice
    pdd_method          = "cg05"   ! PDD integral: "cg05" (Calov and Greve, 2005) or "simple"
    firn_fac            = 0.0266   ! [K (mm w.e. yr-1)-1] Firn warming per annual refreezing
/

&marine_shelf_nor
    bmb_method      = "anom"     ! "pico", "anom", "lin", "quad", "quad-nl", "*-slope"
    tf_method       = 2          ! 1: T_shlf-T_fp_shlf, 2: dT_shlf (needed by bmb_method="anom")
    interp_depth    = "shlf"     ! "shlf", "bed", "const"
    interp_method   = "interp"   ! "mean", "layer", "interp" ! Same method is used for salinity
    find_ocean      = True       ! Find which points are connected to open ocean (ie, ignore subglacial lakes)
    restart         = "None"     ! Load fields from a restart file?
    extrap_shlf     = False      ! Extrapolate ocean front values into the shelf
    mask_ocean      = "none"     ! mask_ocn_ref: ocean (else land)
    mask_deep_ocean = "all"      ! mask_ocn_ref: deep ocean (c_deep), over ocean
    mask_pico_deep  = "none"     ! pico only (bmb_method="pico"): bmb averaged with c_deep there
    bmb_max         = 0.0        ! [m/a] Maximum allowed bmb value (eg, for no refreezing, set bmb_max=0.0)
    c_deep          = -1.0       ! [m/a] Melt rate in deep ocean, should be negative but not huge
    depth_deep      = 2000.0     ! [m] Depth at which deep ocean is assumed
    depth_const     = 2000.0     ! [m] Constant shelf depth for interp_depth=const
    depth_min       = 1100.0     ! [m] interp_method=mean, min depth to include
    depth_max       = 1500.0     ! [m] interp_method=mean, max depth to include
    lambda1         = -0.0575    ! [degC PSU−1] Liquidus slope
    lambda2         = 0.0832     ! [degC] Liquidus intercept
    lambda3         = 7.59e-4    ! [degC m−1] Liquidus pressure coefficient
    gamma_lin       = 630.0      ! [m/yr] Linear heat excange velocity. Favier et al., (2019) suggest 630.
    gamma_quad      = 11100.0    ! [m/yr] Quadratic heat exchange velocity. Jourdain et al. (2020) suggest 11100.
    gamma_quad_nl   = 14500.0    ! [m/yr] Quadratic non-local heat exchange velocity. Jourdain et al. (2020) suggest 14500.
    gamma_prime     = 100.0      ! [-] Scalar when '*-slope' method is used
    kappa_grz       = 10.0       ! [m/a K-1] Heat flux coefficient [kappa*dT]
    c_grz           = 1.0        ! [-] bmb_ref scalar [c_grz*bmb_ref]
    f_grz_shlf      = 10.0       ! [-] Ratio of grz melt to shelf melt
    grz_length      = 32.0       ! [km] Length scale of assumed grounding zone
    use_obs         = False      ! Load obs for bmb_ref
    obs_path        = "ice_data/{domain}/{grid_name}/{grid_name}_BMELT-R13.nc"
    obs_name        = "bm_eq_reese"
    obs_scale       = 1.0        ! [-] bmb_ref = obs_scale*bmb_obs
    obs_lim         = 100.0      ! [m/yr] Maximum magnitude of bmb_ref
/

&shelf_corr_nor
    basins        = "domain"   ! basin ids: <set>, <set>.group, None or domain (one basin)
    corr_method   = "none"     ! none, tf or bmb: corrections by region
    corr_names    = ""
    corr_values   = 0.0
    tf_correction = False
    tf_path       = "none"
    tf_name       = "dT_nl"
/

&yelmo_nor
    domain           = "None"     ! User par file must override this
    grid_name        = "None"     ! User par file must override this
    grid_path        = "fesmdata/{domain}/{grid_name}/{grid_name}_grid.nc"
    experiment       = "None"     ! "None", "EISMINT1", "MISMIP3D"  to apply special boundary conditions
    mask_border      = "auto"     ! Ice mask on the domain border: "auto" (by domain), "none", "fixed", "dynamic"
    nml_ytopo        = "ytopo_nor"
    nml_ycalv        = "ycalv_nor"
    nml_ydyn         = "ydyn_nor"
    nml_ytill        = "ytill_nor"
    nml_ymat         = "ymat_nor"
    nml_ytrc         = "ytrc_nor"
    nml_ytherm       = "ytherm_nor"
    nml_yhyd         = "yhyd_nor"
    nml_masks        = "yelmo_masks_nor"
    nml_init_topo    = "yelmo_init_topo_nor"
    nml_data         = "yelmo_data_nor"
    restart          = "None"
    restart_z_bed    = True       ! Take z_bed (and z_bed_sd) from restart file
    restart_H_ice    = True       ! Take H_ice from restart file
    restart_relax    = 1e3        ! [yrs] Years to relax from restart=>input topography
    log_timestep     = False
    log_mb_check     = False      ! Print global mass-budget check (residual) every timestep
    disable_kill     = False      ! Disable automatic kill if unstable
    zeta_scale       = "exp"      ! "linear", "exp", "tanh"
    zeta_exp         = 2.0
    nz_aa            = 10         ! Vertical resolution in ice
    dt_method        = 2          ! 0: no internal timestep, 1: adaptive, cfl, 2: adaptive, pc
    dt_min           = 0.01       ! [a] Minimum timestep
    cfl_max          = 0.5        ! Maximum value is 1.0, lower will be more stable
    pc_method        = "AB-SAM"   ! "FE-SBE", "AB-SAM", "HEUN"
    pc_controller    = "PI42"     ! PI42, H312b, H312PID, H321PID, PID1
    pc_use_H_pred    = True       ! Use predicted H_ice instead of corrected H_ice
    pc_filter_vel    = True       ! Use mean vel. solution of current and previous timestep
    pc_n_redo        = 5          ! How many times can the same iteration be repeated (when high error exists)
    pc_tol           = 1.0        ! [1/a] Redo the timestep when pc_eta > pc_tol; pc_eta = RMS of tau/(1 m + 0.01 H) over the pc mask without the pc_eta_trim largest, tau = pc truncation error [m/a]
    pc_eps           = 0.02       ! [1/a] Target pc_eta of the adaptive timestep (dt_method=2), must be <= pc_tol
    pc_cfl_max       = 0.5        ! Courant-number cap on the pc adaptive timestep (dt_method=2)
    pc_rho_max       = 2.0        ! Maximum growth factor dt_new/dt per step of the pc adaptive timestep (dt_method=2)
    pc_eta_H_min     = 10.0       ! [m] Thinner ice is not included in the pc error norm
    pc_eta_u_min     = 0.0        ! [m/yr] Slower ice is not included in the pc error norm
    pc_eta_trim      = 0.0        ! [--] Fraction of points with the largest errors left out of the pc error norm
    write_metrics    = False      ! Write numerics/speed metrics to yelmo_metrics.nc
    write_metrics_dt = 100.0      ! [yr] Output cadence for yelmo_metrics.nc
/

&ytopo_nor
    solver          = "impl-lis"   ! "expl", "impl-lis"
    grad_lim        = 0.05         ! [m/m] Maximum allowed sloped in gradient calculations (dz/dx,dH/dx)
    grad_lim_zb     = 0.5          ! [m/m] Maximum allowed sloped in bed gradient (dzb/dx)
    slope_bg_x      = 0.0          ! [m/m] Uniform background slope in x added to dzs/dx and dzb/dx, not contained in z_srf/z_bed (periodic domains with a tilted geometry)
    slope_bg_y      = 0.0          ! [m/m] Uniform background slope in y added to dzs/dy and dzb/dy, not contained in z_srf/z_bed (periodic domains with a tilted geometry)
    front_subgrid   = "marine"     ! Subgrid ice fronts: "none" (binary f_ice), "floating", "marine" (floating + marine-grounded)
    front_H_eff_min = 50.0         ! [m] Minimum effective thickness of front cells (front_subgrid)
    front_dHdx      = 0.0          ! [m/m] Thickness gradient assumed at a full front (front_subgrid)
    use_bmb         = True         ! Use basal mass balance in mass conservation equation
    topo_fixed      = False        ! Keep ice thickness fixed, perform other ytopo calculations
    topo_rel        = 0            ! 0: No relaxation; 1: relax shelf; 2: relax shelf + gl; 3: all points
    topo_rel_tau    = 10.0         ! [a] Time scale for relaxation
    topo_rel_field  = "H_ref"      ! "H_ref" or "H_ice_n"
    bmb_gl_method   = "pmp"        ! "fcmp": flotation; "fmp": full melt; "pmp": partial melt; "nmp": no melt
    gl_sep          = 1            ! 1: binary f_grnd, linear f_grnd_acx/acy; 3: grounded area of H_grnd bilinear between cell centres (Leguy et al., 2021)
    gz_nx           = 15           ! [-] Subgrid points per side (gz_nx*gz_nx) of the grounding-zone melt, bmb_gl_method = "pmpt"
    dist_grz        = 200.0        ! [km] Radius to consider part of "grounding-line zone" (grz)
    gz_Hg0          = 0.0          ! Grounding zone, limit of penetration of bmb_grnd
    gz_Hg1          = 0.0          ! Grounding zone, limit of penetration of bmb_shlf
    dmb_method      = 0            ! 0: no subgrid discharge, 1: subgrid discharge on
    dmb_alpha_max   = 60.0         ! [deg] Maximum angle of slope from coast at which to allow discharge
    dmb_tau         = 100.0        ! [yr]  Discharge timescale
    dmb_sigma_ref   = 300.0        ! [m]   Reference bed roughness
    dmb_m_d         = 3.0          ! [-]   Discharge distance scaling exponent
    dmb_m_r         = 1.0          ! [-]   Discharge resolution scaling exponent
    fmb_method      = 0            ! 0: prescribe boundary field fmb_shlf; 1: calculate proportional fmb~bmb_shlf.
    fmb_scale       = 1.0          ! Scaling of fmb ~ scale*bmb, scale=10 suggested by Pollard and DeConto (2016)
    fmb_lambda      = 1.0          ! fmb_method=3: scaling of the Rignot et al. (2016) frontal melt (ISMIP7 protocol)
/

&ycalv_nor
    use_lsf           = True       ! use level-set method
    lsf_method        = "snap"     ! "snap" (legacy neighbour-snap) or "redist" (Sussman/Osher)
    dt_lsf            = -1         ! [yr] lsf update timescale. If negative: no reset.
    lsf_redist_n_iter = 5          ! Sussman/Osher LSF redistancing iterations. redist mode only.
    calv_flt_method   = "vm-m16"   ! "zero", "simple", "flux", "vm-l19", "kill"
    calv_grnd_method  = "zero"     ! "zero", "stress-b12"
    H_min_grnd        = 0.0        ! [m] Minimum ice thickness at grounded margin (thinner ice is ablated) - helps with stability, smaller value will lead to more precise summit
    H_min_flt         = 0.0        ! [m] Minimum ice thickness at floating margin (thinner ice is ablated) - helps with stability
    H_min_tau         = 10.0       ! [yr] Timescale for removing margin ice thinner than H_min_grnd/H_min_flt and isolated partial cells
    sd_min            = 100.0      ! [m] calv_grnd(z_bed_sd <= sd_min) = 0.0
    sd_max            = 500.0      ! [m] calv_grnd(z_bed_sd >= sd_max) = calv_max
    calv_grnd_max     = 0.0        ! [m/a] Maximum grounded calving rate from high stdev(z_bed)
    calv_tau          = 1.0        ! [a] Characteristic calving time
    calv_thin         = 30.0       ! [m/yr] Calving rate to apply to very thin ice
    k2                = 3.2e9      ! [m yr] eigen calving scaling factor (Albrecht et al, 2021 recommend 1e17 m s == 3.2e9 m yr)
    w2                = 0.0        ! Weighting coefficient of 2nd principal strain/stress
    kt_ref            = 0.0025     ! [m yr-1 Pa-1] vm-l19 calving scaling parameter
    kt_deep           = 0.1        ! [m yr-1 Pa-1] vm-l19 calving scaling parameter for deep ocean
    tau_ice_flt       = 85.0e3     ! [Pa] Ice strength failure, floating fronts (vm-m16)
    tau_ice_grnd      = 85.0e3     ! [Pa] Ice strength failure, marine-grounded fronts (vm-m16)
    Hc_ref_flt        = 200.0      ! [m] Calving limit in ice thickness (thinner ice calves)
    Hc_ref_grnd       = 100.0      ! [m] Calving limit in grounded ice thickness (thinner ice calves)
    Hc_ref_thin       = 50.0       ! [m] Reference ice thickness for thin ice calving
    Hc_deep           = 500.0      ! [m] Calving limit in ice thickness (thinner ice calves)
    zb_deep_0         = -1000.0    ! [m] Bedrock elevation to begin transition to deep ocean
    zb_deep_1         = -1500.0    ! [m] Bedrock elevation to end transition to deep ocean
    zb_sigma          = 0.0        ! [m] Gaussian filtering of bedrock for calving transition to deep ocean
/

&ydyn_nor
    solver               = "diva"                                                              ! "fixed", "sia", "ssa", "hybrid", "diva", "diva-noslip", "l1l2", "l1l2-noslip"
    uz_method            = 3                                                                   ! 1: aa-staggering, 2: strain-rate-on-nodes, 3: jacobian
    visc_method          = 1                                                                   ! 0: constant visc=visc_const, 1: dynamic viscosity
    visc_const           = 1e7                                                                 ! [Pa a] Constant value for viscosity (if visc_method=0)
    beta_method          = 3                                                                   ! 0: constant beta; 1: linear (beta=cb/u0); 2: psuedo-plastic-power; 3: Regularized Coulomb
    beta_const           = 1e3                                                                 ! [Pa a m−1] Constant value of basal friction coefficient to be used
    beta_q               = 0.2                                                                 ! Dragging law exponent (1.0)
    beta_u0              = 100.0                                                               ! [m/a] Regularization term for regularized Coulomb law (beta_method=3)
    beta_gl_scale        = 0                                                                   ! 0: beta*beta_gl_f, 1: H_grnd linear scaling, 2: Zstar scaling
    beta_gl_stag         = 3                                                                   ! 0: simple staggering, 1: Upstream beta at gl, 2: downstream, 3: f_grnd_ac scaling
    beta_gl_f            = 1.0                                                                 ! [-] Scaling of beta at the grounding line (for beta_gl_scale=0)
    taud_gl_method       = 0                                                                   ! 0: binary, no subgrid, 1: Two-sided gradient
    H_grnd_lim           = 500.0                                                               ! [m] For beta_gl_scale=1, reduce beta linearly between H_grnd=0 and H_grnd_lim
    beta_min             = 100.0                                                               ! [Pa a m-1] Minimum value of beta allowed for grounded ice (for stability)
    eps_0                = 1e-6                                                                ! [1/a] Regularization term for effective viscosity - minimum strain rate
    frz_scale            = True                                                                ! Reduce sliding where the bed is below the pressure melting point: beta*f**(-q), f=frz_min+(1-frz_min)*exp(T_prime_b/frz_efold)
    frz_efold            = 3.0                                                                 ! [K] e-folding temperature of the sliding speed (at fixed basal stress, any friction law)
    frz_min              = 1e-3                                                                ! [-] Minimum sliding-speed factor for frozen beds
    ssa_solver           = "energy"                                                            ! "residual" | "energy"
    ssa_lis_opt_residual = "-i minres -p jacobi -maxiter 100 -tol 1.0e-1 -initx_zeros false"   ! See Lis library !-omp_num_threads 2
    ssa_lis_opt_energy   = "-i cg -p ssor -maxiter 200 -tol 1.0e-3 -initx_zeros false"         ! SPD => CG; tol 1e-3 is below the Picard tolerance ssa_iter_conv
    ssa_lat_bc           = "all"                                                               ! "all", "marine", "floating", "none"
    ssa_vel_lim_method   = "drag"                                                              ! "clip": clip each velocity component at ssa_vel_max; "drag": smooth speed-limit drag on all free faces, tau = ssa_vel_lim_tau at ssa_vel_max, components also clipped at ssa_vel_max
    ssa_vel_max          = 10000.0                                                             ! [m a-1] Velocity limit: clip value (both methods); "drag": also the speed at which the limit drag reaches ssa_vel_lim_tau
    ssa_vel_lim_tau      = 1e5                                                                 ! [Pa] Speed-limit drag at ssa_vel_max (ssa_vel_lim_method="drag")
    ssa_iter_max         = 5                                                                   ! Number of maximum allowed iterations over ssa to converge on vel. solution (20)
    ssa_iter_rel         = 0.7                                                                 ! [--] Relaxation fraction [0:1] to stabilize ssa iterations
    ssa_iter_conv        = 1e-1                                                                ! [--] L2 relative error convergence limit to exit ssa iterations (1e-2)
    taud_lim             = 2e5                                                                 ! [Pa] Maximum allowed driving stress
    neff_nxi             = 0                                                                   ! Subgrid interpolation of hyd%N onto dyn%N_eff. 0: none, 1: Gaussian quadrature, >1: nxi x nxi subgrid.
/

&ytill_nor
    method    = 1        ! -1: set externally; 1: calculate cb_ref online
    scale_zb  = 2        ! 0: none, 1: lin, 2: exp : scaling with elevation
    scale_sed = 0        ! 0: none, 1: min(cb_zb,cb_sed), 2: cb_zb*(lambda_sed*f_sed), 3: 2 but no lower limit
    is_angle  = False    ! cb_ref is a till strength angle?
    n_sd      = 10       ! Number of samples over z_bed_sd field
    f_sed     = 1.0      ! Scaling reduction for thick sediments
    sed_min   = 5.0      ! [m] Sediment thickness for no reduction in friction
    sed_max   = 15.0     ! [m] Sediment thickness for maximum reduction in friction
    z0        = -100.0   ! [m] Bedrock rel. to sea level, lower limit
    z1        = 100.0    ! [m] Bedrock rel. to sea level, upper limit
    cf_min    = 0.001    ! [-- or deg] Minimum value of cf
    cf_ref    = 0.1   ! [-- or deg] Reference/const/max value of cf (calib-cf; the base has 0.1)
/

&yhyd_nor
    method_til                     = 1                       ! 0=NONE 1=BUCKET
    method_transport               = 0                       ! 0=NONE 1=K24
    W_til_max                      = 0.4                     ! [m]   was ytherm.H_w_max
    mask_bc                        = 2                       ! 0=ZERO 1=IMPOSED 2=MIRROR
    W_til_bc                       = 0.0                     ! [m]
    bkt_N_closure                  = 3                       ! 0=CONST 1=OVERBURDEN 2=MARINE 3=TILL 4=TWO_VALUE
    bkt_till_rate                  = 0.008                   ! [m/a]  was ytherm.till_rate
    bkt_floating_mode              = 0                       ! 0=ZERO 1=MARGIN_FILL (legacy saturate floating+margin ring)
    const_N                        = 1.0e7                   ! [Pa] N_CLOSURE_CONST (legacy yneff.const)
    marine_p                       = 0.0
    marine_rho_sw                  = 1028.0                  ! [kg/m3] ignored by yelmo: overwritten by yelmo_phys_const.nml rho_sw (as are rho_ice, rho_w, g)
    till_N0                        = 1000.0                  ! legacy yneff.N0
    till_delta                     = 0.04                    ! legacy yneff.delta
    till_e0                        = 0.69                    ! legacy yneff.e0
    till_Cc                        = 0.12                    ! legacy yneff.Cc
    two_value_delta                = 0.02
    k24_substrate_type             = 2                       ! 0=HARD 1=SOFT 2=MIXED (binary, z_bed<-1000) 3=MIXED_SMOOTH (ramp); 4=EXTERNAL not supported by yelmo (Fortran-only; builds kappa)
    k24_kappa_z_hard               = -500.0                  ! MIXED_SMOOTH: z_bed at/above which the bed is hard, kappa = 0 [m]
    k24_kappa_z_soft               = -1500.0                 ! MIXED_SMOOTH: z_bed at/below which the bed is soft, kappa = 1 [m]
    k24_flux_solver                = 3                       ! 0=RECURSIVE 1=ITERATIVE 2=TOPOSORT (GDS_WARNER only) 3=TAPED (default)
    k24_routing_scheme             = 0                       ! 0=WARNER 1=GDS_WARNER (original K24) 2=QUINN 3=TARBOTON 4=MODIFIED_TARBOTON 5=GDS_TARBOTON
    k24_quinn_original             = False                   ! QUINN only: Quinn et al.'s own slope x contour-length weights
    k24_fill_algorithm             = -1                      ! -1=AUTO (JACOBI for GDS schemes, else PRIORITY_FLOOD) 0=JACOBI 1=LOWEST_NEIGHBOUR 2=PRIORITY_FLOOD
    k24_priority_flood_epsilon     = 1.0                     ! [Pa] potential step across a filled pit/flat
    k24_q_conversion               = -1                      ! -1=AUTO (FACE_AVERAGE for WARNER, else OUTFLOW) 0=OUTFLOW 1=FACE_AVERAGE
    k24_dissipation_discretization = -1                      ! -1=AUTO (FACE for WARNER, else CELL) 0=CELL 1=FACE
    k24_friction_discretization    = 0                       ! 0=CELL (tau_b*|u_b|) 1=STAGGERED (C-grid velocities)
    k24_friction_quadrature        = False                   ! STAGGERED only: Yelmo's qb_method=2 Gauss-point heat
    k24_friction_u_floor           = 3.168808781402895e-11   ! [m/s] = 1e-3 m/yr, STAGGERED beta floor
    k24_toposort_allow_cycles      = False                   ! TopologicalPsiOut(allow_cycles=...)
    k24_N_ub_coupled               = True                    ! DIVA velocity iteration re-evaluates K24 N from u_b (hydro_N_from_ub); False = N once per step
    k24_drainage_mode              = 0                       ! 0=BOTH 1=EFFICIENT_ONLY 2=INEFFICIENT_ONLY
    k24_water_thickness_algorithm  = 0                       ! 0=DARCY_WEISBACH 1=LAMINAR 2=AREAL_CONDUIT
    k24_gradient_convention        = 0                       ! 0=MEAN 1=LOCAL (Darcy-Weisbach / laminar closures only)
    k24_sliding_law                = 0                       ! 0=NO_FRICTION 1=WEERTMAN 2=POWER_PLASTIC 3=REG_COULOMB 4=PRESCRIBED_FIELD 5=REG_COULOMB_FIELD 6=SHAKTI_REG_COULOMB
    k24_glen_n                     = 3.0                     ! n, Glen's flow-law exponent
    k24_latent_heat_water          = 3.35e5                  ! L_w [J/kg]; overridden by yelmo L_ice (phys_const)
    k24_bed_bump_height            = 0.1                     ! h_b, bed obstacle height [m]
    k24_flux_W_exponent            = 1.25                    ! alpha = 5/4
    k24_flux_grad_exponent         = 1.5                     ! beta  = 3/2
    k24_friction_factor            = 0.1                     ! f, Darcy-Weisbach friction factor
    k24_till_factor                = 1.1                     ! F_till
    k24_critical_discharge         = 1.0                     ! Q_c [m3/s]
    k24_H0_efficient               = 0.1                     ! H_0 [m]
    k24_conduit_spacing            = 1.0e4                   ! l_c, conduit spacing [m]
    k24_coupling_length_kamb86     = 10.0                    ! Kamb & Echelmeyer (1986) coupling length / ice thickness; 0 disables the smoothing entirely
    k24_water_viscosity            = 1.8e-3                  ! water_viscosity [Pa s] = 1.8e-3 per year
    k24_min_pressure_fraction      = 0.02                    ! sigmat        (KORI-ULB: 0.02)
    k24_W_min                      = 1.0e-8                  ! Wmin  [m]     (KORI-ULB: 1.0e-8)
    k24_W_max                      = 0.015                   ! Wmax  [m]     (KORI-ULB: 0.015)
    k24_q_min                      = 0.0                     ! q_min [m2/s]
    k24_q_max                      = 1.0e30                  ! q_max [m2/s]  (KORI-ULB: 3.168808781402895e-3 = 1e5 per year)
    k24_fill_iters                 = 10                      ! fill_iters
    k24_max_psi_out_calls          = 100000                  ! max_psi_out_calls
    k24_dissipation_melt           = True                    ! add |q*grad(phi0)|/(L_w*rho_w) to the source
    k24_max_dissipation_iters      = 20                      ! max_dissipation_iters
    k24_dissipation_rtol           = 1.0e-12                 ! dissipation_rtol
    k24_dissipation_verbose        = True                    ! dissipation_verbose
    k24_max_qN_iters               = 20                      ! max_qN_iters        (N-dependent sliding laws)
    k24_qN_rtol                    = 1.0e-8                  ! qN_rtol
    k24_qN_verbose                 = True                    ! qN_verbose
    k24_weertman_C                 = 0.0                     ! WeertmanSlidingLaw.C [Pa (s/m)^q]
    k24_weertman_q                 = 0.3333333333333333      ! WeertmanSlidingLaw.q
    k24_power_plastic_c_till       = 0.0                     ! PowerPlasticSlidingLaw.c_till
    k24_power_plastic_q            = 1.0                     ! PowerPlasticSlidingLaw.q
    k24_power_plastic_u0           = 3.168808781402895e-06   ! PowerPlasticSlidingLaw.u0 [m/s] = 100 m/yr
    k24_reg_coulomb_c_till         = 0.0                     ! RegularizedCoulombSlidingLaw.c_till
    k24_reg_coulomb_q              = 0.3333333333333333      ! RegularizedCoulombSlidingLaw.q
    k24_reg_coulomb_u0             = 3.168808781402895e-06   ! RegularizedCoulombSlidingLaw.u0 [m/s] = 100 m/yr
    k24_shakti_C                   = 0.0                     ! ShaktiRegularizedCoulombSlidingLaw.C
    k24_shakti_n                   = 3.0                     ! ShaktiRegularizedCoulombSlidingLaw.n
    k24_shakti_lambda_coeff        = 1.5                     ! lambda = coeff * A_glen
/

&ymat_nor
    rf_method         = 1           ! -1: set externally; 0: rf_const everywhere; 1: standard function
    rf_const          = 1e-18       ! [Pa^-3 a^-1]
    rf_use_eismint2   = False       ! Only applied for rf_method=1
    rf_with_water     = False       ! Only applied for rf_method=1, scale rf by water content?
    n_glen            = 3.0         ! Glen flow law exponent
    visc_min          = 1e3         ! [Pa a] Minimum allowed viscosity
    de_max            = 100.0       ! [a-1]  Maximum allowed effective strain rate (high: no cap in most cases; only limits strain heating and mat viscosity)
    enh_method        = "shear3D"   ! "simple","shear2D", "shear3D", "paleo-shear"
    enh_shear         = 3.0
    enh_stream        = 1.0
    enh_shlf          = 0.7
    enh_umin          = 50.0        ! [m/yr] Minimum transition velocity to enh_stream (enh_method="paleo-shear")
    enh_umax          = 500.0       ! [m/yr] Maximum transition velocity to enh_stream (enh_method="paleo-shear")
    tracer_method     = "expl"      ! "expl", "impl": used for age and 'paleo-shear' enh fields
    tracer_impl_kappa = 1.5         ! [m2 a-1] Artificial diffusion term for implicit tracer solving
/

&ytherm_nor
    method          = "enth"       ! "enth","temp","robin","robin-cold","linear","fixed"
    qb_method       = 2            ! 1: faces, 2: faces to quadrature nodes, 3: simple-stagger, 4: quadrature (1, 2: energy-consistent)
    dt_method       = "FE"         ! "FE", "AB", "SAM"
    advecxy_order   = 2            ! Horizontal advection order: 1=upwind, 2=flux-limited 2nd-order upwind
    advecxy_cfl     = 0.5          ! [--] Target Courant number per horizontal-advection sub-step (CFL_safe)
    advecxy_nmax    = 10           ! [--] Max horizontal-advection sub-steps (safety cap; warns if hit)
    gamma           = 1.0          ! [K] Scalar for the pressure melting point decay function
    strain_heating  = "full"       ! "full": from 3D viscosity and strain rate, "sia": SIA approx., "none": no strain heating
    use_const_cp    = False        ! Use specified constant value of heat capacity?
    const_cp        = 2009.0       ! [J kg-1 K-1] Specific heat capacity
    use_const_kt    = False        ! Use specified constant value of heat conductivity?
    const_kt        = 6.62e7       ! [J a-1 m-1 K-1] Thermal conductivity [W m-1 K-1 * sec_year] => [J a-1 m-1 K-1]
    enth_cr         = 1e-3         ! [--] Conductivity ratio for temperate ice (kappa_temp     = enth_cr*kappa_cold)
    omega_max       = 0.01         ! [--] Maximum allowed water content fraction
    H_ice_thin      = 10.0         ! [m] Skip column solver below this thickness (linear profile imposed)
    enth_cp_method  = "integral"   ! Enthalpy heat capacity: "const" (cp_ref) or "integral" (int cp(T) dT); ignored if use_const_cp
    basal_bc_method = "capacity"   ! Grounded basal BC: "capacity" (bmb_grnd* vs freeze-on capacity C) or "wtil" (till-water predictor, deprecated)
    cap_source      = "auto"       ! [capacity] C from: "auto" ("hyd" with water transport, else "till"), "hyd" (hydrology model), "till" (bucket W_til), "water" (water thickness W), "none" (C=0)
    cap_W_floor     = 0.0          ! [m] [capacity, "till"/"water"] floor subtracted from the water thickness
    cap_eps         = 1e-4         ! [m/a ice equiv.] [capacity] C below this counts as a dry bed
    gl_temperate    = True         ! Hold grounded bases next to floating ice or open ocean at the pressure melting point (ocean-wetted bed)
    rock_method     = "active"     ! "equil" (not active bedrock) or "active"
    nzr_aa          = 5            ! Number of vertical points in bedrock
    zeta_scale_rock = "exp-inv"    ! "linear", "exp-inv"
    zeta_exp_rock   = 2.0
    H_rock          = 2000.0       ! [m] Lithosphere thickness
    rhoc_rock       = 2.0e6        ! [J m-3 K-1] Volumetric heat capacity of bedrock (rho*cp)
    kt_rock         = 6.3e7        ! [J a-1 m-1 K-1] Thermal conductivity of bedrock [W m-1 K-1 * sec_year] => [J a-1 m-1 K-1]
/

&yelmo_masks_nor
    regions_group     = "None"               ! the regions come from the driver ([regions])
    basins            = "domain"             ! <set>, <set>.group, None or domain (one basin)
    mask_ice_dynamic  = "~zone:open_ocean"   ! where ice is dynamic, else no ice (selection expression of the regions)
    mask_ice_fixed    = "none"               ! where ice thickness is prescribed (over mask_ice_dynamic)
    relax             = "none"               ! where ice relaxes to H_ice_ref (ytopo.topo_rel = -1)
    relax_tau         = 0.0                  ! [yr] relaxation timescale there
    border_width      = 0 0                  ! N M: strip of N fixed cells, then M relaxation cells (relax_tau) inward, at the edge of the region where ice is allowed; 0 0 = none
    mask_rmse         = "all"                ! where the error metrics are computed
    dynamic_connected = False                ! keep only the dynamic cells connected to the ice sheet (largest region of present-day, else initial, ice); others no ice
/

&yelmo_init_topo_nor
    init_topo_load  = True
    init_topo_path  = "fesmdata/{domain}/{grid_name}/{grid_name}_TOPO-BedMachine-v6.nc"
    init_topo_names = "H_ice" "z_bed" "z_bed_sd" "z_srf"   ! Ice thickness, bedrock elevation, bedrock noise, surface elevation
    init_topo_state = 0                                    ! 0: from file, 1: ice-free, 2: ice-free, rebounded
    z_bed_f_sd      = 0.0                                  ! Scaling fraction to modify z_bed = z_bed + f_sd*z_bed_sd
    smooth_H_ice    = 0.0                                  ! Smooth ice thickness field at loading time, with sigma=N*dx
    smooth_z_bed    = 0.0                                  ! Smooth bedrock field at loading time, with sigma=N*dx
/

&yelmo_data_nor
    pd_topo_load    = True
    pd_topo_path    = "fesmdata/{domain}/{grid_name}/{grid_name}_TOPO-BedMachine-v6.nc"
    pd_topo_names   = "H_ice" "z_bed" "z_bed_sd" "z_srf"   ! Ice thickness, bedrock elevation, bedrock noise, surface elevation
    pd_tsrf_load    = False
    pd_tsrf_path    = "fesmdata/{domain}/{grid_name}/{grid_name}_Atmosphere-ERA5-1981-2010.nc"
    pd_tsrf_name    = "t2m"                                ! Surface temperature (or near-surface temperature)
    pd_tsrf_monthly = True
    pd_smb_load     = False
    pd_smb_path     = "none"
    pd_smb_name     = "smb"                                ! Surface mass balance
    pd_smb_monthly  = False
    pd_vel_load     = False
    pd_vel_path     = "none"
    pd_vel_names    = "ux_srf" "uy_srf"                    ! Surface velocity
    pd_age_load     = False
    pd_age_path     = "none"
    pd_age_names    = "age" "depth_iso"                    ! ages of isochrones; depth of isochrones
    pd_age_to_time  = True                                 ! Convert loaded obs isochrone ages [ka] to deposition times [ka] (t_dep = -age)
/

&ytrc_nor
    use_euler         = False                         ! Run the in-tree Eulerian age tracer?
    use_tracer        = False                         ! Run the Lagrangian particle backend (tracer)?
    use_elsa          = False                         ! Run the Lagrangian layer backend (elsa)?
    elsa_restart      = True                          ! On a restart, restore elsa's layers (False: start them fresh)
    t_dep_source      = "euler"                       ! "euler", "trc", "elsa": authoritative deposition-time source
    time_end          = 0.0                           ! [yr] simulation end time for use_elsa (sizes elsa's layer stack; 0.0 = present day)
    calc_age          = False                         ! Calculate the Eulerian age tracer field?
    time_iso          = -11.7, -29.0, -57.0, -115.0   ! [ka] isochrone deposition times
    tracer_method     = "expl"                        ! "expl", "impl": Eulerian age solver
    tracer_impl_kappa = 1.5                           ! [m2 a-1] Artificial diffusion term for implicit age solving
    advecxy_order     = 2                             ! Horizontal advection order: 1=upwind, 2=flux-limited 2nd-order upwind
    advecxy_cfl       = 0.5                           ! [--] Target Courant number per horizontal-advection sub-step
    advecxy_nmax      = 10                            ! [--] Max horizontal-advection sub-steps (safety cap; warns if hit)
    elsa_nml          = "None"                        ! Path to elsa namelist file
    elsa_group        = "None"                        ! Group name within elsa_nml
    tracer_nml        = "None"                        ! Path to tracer namelist file (group "trc")
/

&term_lgm
    coef    = "alpha"       ! the coefficient ([forcing] coefs); "" = the constant 1 (snapshots pattern)
    pattern = "snapshots"   ! snapshots: f*(snap1 - snap0), or f*snap1 without snap0 (a given anomaly / ratio);
    snap0   = "picontrol"   ! snapshots: the snapshot at coefficient 0 ([snapshot_<name>]); "" = none
    snap1   = "lgm"         ! snapshots: the snapshot at coefficient 1
    fields  = "tas" "pr"    ! the fields the term touches: tas, pr, to, so (explicit, all bound by its snapshots and the reference)
    f_ta    = 1.0           ! [K]   uniform: gain on tas (and the pr factor)
    f_to    = 1.0           ! [K]   uniform: gain on to
    f_so    = 1.0           ! [psu] uniform: gain on so
/

&term_ocean
    coef    = "dTo"       ! the coefficient ([forcing] coefs); "" = the constant 1 (snapshots pattern)
    pattern = "uniform"   ! snapshots: f*(snap1 - snap0), or f*snap1 without snap0 (a given anomaly / ratio);
    snap0   = ""          ! snapshots: the snapshot at coefficient 0 ([snapshot_<name>]); "" = none
    snap1   = ""          ! snapshots: the snapshot at coefficient 1
    fields  = "to"        ! the fields the term touches: tas, pr, to, so (explicit, all bound by its snapshots and the reference)
    f_ta    = 1.0         ! [K]   uniform: gain on tas (and the pr factor)
    f_to    = 1.0         ! [K]   uniform: gain on to
    f_so    = 1.0         ! [psu] uniform: gain on so
/

&snapshot_pd_nor
    exp        = ""     ! experiment, the {exp} of its var_defs paths (lgm, piControl, ...)
    monthly    = True   ! tas/pr monthly (else tas = [annual, season], pr annual)
    clim_sigma = 0.0    ! [km] gaussian smoothing of the atmosphere at loading; 0 = none
    ocn_sigma  = 0.0    ! [km] gaussian smoothing of the ocean at loading; 0 = none
    tas_season = ""     ! season of the second tas group: jja | djf; "" = the summer of the hemisphere
    tas        = "era5_1981_2010_tas"
    pr         = "era5_1981_2010_pr"
    zs         = "era5_1981_2010_zs"
    to         = "oras5_1981_2010_to"
    so         = "oras5_1981_2010_so"
/

&snapshot_picontrol
    exp        = "piControl"   ! experiment, the {exp} of its var_defs paths (lgm, piControl, ...)
    monthly    = False         ! tas/pr monthly (else tas = [annual, season], pr annual)
    clim_sigma = 50.0          ! [km] smoothing of the PMIP3 fields
    ocn_sigma  = 0.0           ! [km] gaussian smoothing of the ocean at loading; 0 = none
    tas_season = ""            ! season of the second tas group: jja | djf; "" = the summer of the hemisphere
    tas        = "pmip3_mean_tas_ann" "pmip3_mean_tas_jja"
    pr         = "pmip3_mean_pr_ann"
    zs         = "pmip3_mean_zs"
    to         = ""
    so         = ""
/

&snapshot_lgm
    exp        = "lgm"   ! experiment, the {exp} of its var_defs paths (lgm, piControl, ...)
    monthly    = False   ! tas/pr monthly (else tas = [annual, season], pr annual)
    clim_sigma = 50.0    ! [km] smoothing of the PMIP3 fields
    ocn_sigma  = 0.0     ! [km] gaussian smoothing of the ocean at loading; 0 = none
    tas_season = ""      ! season of the second tas group: jja | djf; "" = the summer of the hemisphere
    tas        = "pmip3_mean_tas_ann" "pmip3_mean_tas_jja"
    pr         = "pmip3_mean_pr_ann"
    zs         = "pmip3_mean_zs"
    to         = ""
    so         = ""
/

&era5_1981_2010_tas
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Atmosphere-ERA5-1981-2010.nc"
    name     = "t2m"
    units    = "K" "K"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&era5_1981_2010_pr
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Atmosphere-ERA5-1981-2010.nc"
    name     = "pr"
    units    = "kg m-2 d-1" "mm d-1"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&era5_1981_2010_zs
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Atmosphere-ERA5-1981-2010.nc"
    name     = "zs"
    units    = "m" "m"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&oras5_1981_2010_to
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Ocean-ORAS5-1981-2010.nc"
    name     = "to"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 12
    fill     = "nearest"
/

&oras5_1981_2010_so
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Ocean-ORAS5-1981-2010.nc"
    name     = "so"
    units    = "PSU" "PSU"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 12
    fill     = "nearest"
/

&pmip3_mean_tas_ann
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-PMIP3-{exp}-mean.nc"
    name     = "t2m_ann"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&pmip3_mean_tas_jja
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-PMIP3-{exp}-mean.nc"
    name     = "t2m_jja"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&pmip3_mean_pr_ann
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-PMIP3-{exp}-mean.nc"
    name     = "pr_ann"
    units    = "mm d-1" "mm d-1"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&pmip3_mean_zs
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-PMIP3-{exp}-mean.nc"
    name     = "z_srf"
    units    = "m" "m"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&Antarctica
    grid_hub    = "ANT-16KM"     ! yelmox domain.grid_hub
    topo        = "topo_ant"
    regions     = "regions_ant"
    basins      = "Zwally2012"   ! yelmox domain.basins
    out_2D      = "out_2D"       ! yelmox output.write_htopo
    ice         = "ice_ant"
    geo         = "geo_ant"
    climate     = "climate_ant"
    surface     = "surface_ant"
    shelf       = "shelf_ant"
    geothermal  = "ghf_ant"
    sediments   = "sed_ant"
    experiments = ""
/

&ice_ant
    backend         = "yelmo"
    grid            = "ANT-32KM"   ! yelmox domain.grid_ice
    dt              = 0.0
    phase           = 0.0
    clock           = "model"
    out_2D          = "out_2D"     ! yelmox output.write_yelmo
    out_1D          = "out_1D"     ! yelmox output.write_yelmo
    out_vars        = ""
    yelmo           = "yelmo_ant"
    init_equil_time = 10.0         ! yelmox sim.init_method = equil, sim.init_equil_time
    init_time_thrm  = 0.0          ! yelmox sim.init_time_thrm
    out_yelmo       = "out_2D"     ! yelmox output.write_yelmo
    out_yelmo_sm    = "out_2Dsm"   ! yelmox output.write_yelmo
    out_yelmo_ts    = "out_1D"     ! yelmox output.write_yelmo
/

&geo_ant
    backend     = "fastisostasy"
    grid        = "ANT-32KM"   ! yelmox domain.grid_isos
    dt          = 10.0         ! yelmox comps.dt_isos
    phase       = 0.0
    clock       = "model"
    out_2D      = "out_2D"     ! yelmox output.write_isos
    out_1D      = "out_1D"     ! yelmox output.write_isos
    out_vars    = ""
    isos        = "isos_ant"
    out_isos    = "out_2D"     ! yelmox output.write_isos
    out_isos_ts = "out_1D"     ! yelmox output.write_isos
    out_bsl_ts  = "none"
/

&climate_ant
    backend   = "snapshots"   ! yelmox comps.climate
    grid      = "ANT-32KM"    ! yelmox domain.grid_clim
    dt        = 10.0          ! yelmox comps.dt_clim
    phase     = 0.0
    clock     = "forcing"
    out_2D    = "out_2D"      ! yelmox output.write_clim
    out_1D    = "none"
    out_vars  = ""
    snapshots = "snapshots_ant"
    reference = "pd_ant"      ! yelmox forcing.reference
    terms     = ""            ! yelmox forcing.terms
/

&surface_ant
    backend       = "chion"      ! yelmox comps.surface_method
    grid          = "ANT-32KM"   ! yelmox domain.grid_surface
    dt            = 0.0
    phase         = 0.0
    clock         = "forcing"
    out_2D        = "out_2D"     ! yelmox output.write_surface
    out_1D        = "none"
    out_vars      = ""
    surface_chion = "surface_chion_ant"
    chion         = "chion_ant"
    orbit         = "orbit_ant"
/

&shelf_ant
    backend      = "marine_shelf"
    grid         = "ANT-16KM"   ! yelmox domain.grid_shelf
    dt           = 0.0
    phase        = 0.0
    clock        = "model"
    out_2D       = "out_2D"     ! yelmox output.write_shelf
    out_1D       = "none"
    out_vars     = ""
    marine_shelf = "marine_shelf_ant"
    corr         = "shelf_corr_ant"
/

&ghf_ant
    backend   = "data"
    grid      = ""
    dt        = -1.0
    phase     = 0.0
    clock     = "model"
    out_2D    = "none"
    out_1D    = "none"
    out_vars  = ""
    Q_geo     = "Q_geo_ant"
    Q_geo_min = 0.0001
/

&sed_ant
    backend  = "data"
    grid     = ""
    dt       = -1.0
    phase    = 0.0
    clock    = "model"
    out_2D   = "none"
    out_1D   = "none"
    out_vars = ""
    H_sed    = "H_sed_ant"
/

&Q_geo_ant
    filename     = "fesmdata/{domain}/{grid_name}/{grid_name}_GHF-Shapiro2004.nc"
    name         = "ghf"
    mode         = "static"
    value        = 0.0
    time_method  = "auto"
    out_of_range = "error"
    units        = "auto" "auto"
    scaling      = 1.0 0.0
    remap        = "auto"
    grid_src     = ""
    fill         = "nearest"
    fill_value   = 0.0
    anomaly_ref  = "none"
    ref_time     = 0.0
    ref_group    = ""
    time         = -1 0 0 0 0
    time_units   = ""
    calendar     = ""
/

&H_sed_ant
    filename     = ""
    name         = ""
    mode         = "const"
    value        = 0.0
    time_method  = "auto"
    out_of_range = "error"
    units        = "auto" "auto"
    scaling      = 1.0 0.0
    remap        = "auto"
    grid_src     = ""
    fill         = "none"
    fill_value   = 0.0
    anomaly_ref  = "none"
    ref_time     = 0.0
    ref_group    = ""
    time         = -1 0 0 0 0
    time_units   = ""
    calendar     = ""
/

&topo_ant
    path         = "fesmdata/{domain}/{grid_name}/{grid_name}_TOPO-BedMachine-v4.nc"
    vars         = "z_bed" "z_srf" "H_ice" "z_bed_sd"
    remap        = "con"
    z_bed_f_sd   = 0.0    ! Preparation of the reference (hub): z_bed = z_bed + f_sd*z_bed_sd
    remove_lakes = True   ! Remove englacial lakes (sea level 0)
    H_ice_min    = 1.0    ! [m] Remove ice thinner than this
    grad_lim_zb  = 0.5    ! [m/m] Limit the bed gradient (dzb/dx)
/

&regions_ant
    path_regions = "fesmdata/{domain}/{grid_name}/{grid_name}_REGIONS.nc"
    path_basins  = "fesmdata/{domain}/{grid_name}/{grid_name}_BASINS-{set}.nc"
    basin_sets   = "Zwally2012"
    masks        = "APIS" "WAIS" "EAIS"
    mask_APIS    = "region:Antarctic_Peninsula"
    mask_WAIS    = "region:West_Antarctica"
    mask_EAIS    = "region:East_Antarctica"
/

&isos_ant
    heterogeneous_ssh              = .true.                                                          ! Sea level varies spatially?
    interactive_sealevel           = .true.                                                          ! Sea level interacts with solid Earth deformation?
    include_elastic                = .true.                                                          ! Include elastic deformation?
    correct_compression            = .true.                                                          ! Account for compression effects on relaxation time?
    correct_distortion             = .false.                                                         ! Account for distortion of projection?
    method                         = 3                                                               ! 0: constant displacement; 1: LLRA; 2: LV-ELRA, 3: LV-ELVA
    dt_diagnostics                 = 10.                                                             ! [yr] Min. timestep to recalculate diagnostics
    pad                            = 1024.                                                           ! [km] Padding around the domain (preferably chosen as a power
    mantle                         = "rheology_file"                                                 ! Choose mantle viscosity field, options:
    lithosphere                    = "rheology_file"                                                 ! Choose lithospheric thickness field:
    layering                       = "parallel"                                                      ! "parallel" or "equalized"
    lumping                        = "min"                                                           ! "bottom", "min", "max", "mean", "logmean", "freqdomain"
    viscosity_scaling_method       = "none"                                                          ! "scale" or "min" or "max"
    viscosity_scaling              = 1.                                                              ! Only used if viscosity_scaling_method = "scale"
    nl                             = 5                                                               ! [1] Number of viscous layers for sub-lithospheric mantle
    dl                             = 25.                                                             ! [km] Thickness of viscous layers. Only used if layering="parallel".
    zl                             = 100, 150, 200, 250, 300                                         ! [km] Depth of layer boundaries.
    viscosities                    = 1e21, 1e21, 1e21, 1e21, 2e21                                    ! [Pa s] Layer viscosities. Only used if
    ref_viscosity                  = 1.e21                                                           ! [Pa s] Reference viscosity for scaling
    tau                            = 3000.0                                                          ! [yr] Relaxation time used for "method" = 2
    rheo_smoothing_radius          = 40.0                                                            ! [km] Gaussian moothing radius for lithospheric thickness
    litho_thickness_scaling        = 1.0                                                             ! Scaling factor for lithospheric thickness. Only used if lithosphere = "rheology_file"
    E                              = 66.0                                                            ! [GPa] Young modulus
    nu                             = 0.28                                                            ! [-] Poisson ratio
    rho_litho                      = 3200.0                                                          ! [kg/m^3]  Optionally set to 0 ==> decouple the elastic
    r_earth                        = 6.378e3                                                         ! [km] Earth radius, Coulon et al. (2021)
    m_earth                        = 5.972e24                                                        ! [kg] Earth mass,   Coulon et al. (2021)
    restart                        = "None"
    mask_file                      = "None"
    rheology_file                  = "isostasy_data/earth_structure/yelmo/{grid_name}_GIA_HR24.nc"   ! {grid_name} = grid_isos
    litho_thickness_varname        = "litho_thickness"                                               ! Variable name in netcdf file
    log10_viscosity_varname        = "log10_visc"                                                    ! Variable name in netcdf file
    stddev_log10_viscosity_varname = "stddev_log10_visc"                                             ! Variable name in netcdf file
    dt_method                      = "tsit54"                                                        ! Time stepping method, options: "euler", "rk4", "bs32", "tsit54"
    dt_init                        = 1.0                                                             ! [yr] Initial time step for time stepping method. If dt_method
    dt_min                         = 1e-10                                                           ! [yr] Minimum dt. Only used if dt_method is "bs32" or "tsit54".
    dt_max                         = 10.0                                                            ! [yr] Maximum dt. Only used if dt_method is "bs32" or "tsit54".
    rtol                           = 1e-4                                                            ! Relative tol. Only used if dt_method is "bs32" or "tsit54".
    atol                           = 1e-2                                                            ! Absolute tol. Only used if dt_method is "bs32" or "tsit54".
    q                              = 1.0                                                             ! Exponent for dt adaptation. The higher the most conservative the time stepping.
/

&snapshots_ant
    grid_global = "GLOBAL-1DEG"               ! global grid of the paleoclimate products ({grid_global})
    fields      = "tas" "pr" "to" "so" "zs"   ! the fields a snapshot may bind
    lapse       = 0.0080 0.0065               ! [K m-1] lapse rates: annual, summer
    f_p         = 0.05                        ! [K-1] precipitation-temperature scaling (beta_p)
/

&orbit_ant
    method = "fixed_time"   ! forcing_time: at the forcing time; fixed_time: at time; fixed_orbit: ecc, obl, per
    time   = 0.0            ! [yr] model time of the orbit (fixed_time; relative to 1950, past < 0)
    ecc    = 0.016702       ! [1]   eccentricity (fixed_orbit; these: the tables at 1950)
    obl    = 23.4393        ! [deg] obliquity (fixed_orbit)
    per    = 102.918        ! [deg] longitude of perihelion (fixed_orbit)
    fldr   = "input"        ! folder of the orbital tables (LA2004.INSOLN.5Ma.txt, LA2004.INSOLP.1Ma.txt)
/

&surface_chion_ant
    sf_a       = 0.273   ! Snow fraction function (parameter a)
    sf_b       = 273.6   ! Snow fraction function (parameter b)
    sigma_pdd  = 5.0     ! [K] Temperature standard deviation for the annual PDDs (itm)
    time_equil = 100.0   ! [yr] Cold-start snowpack spin-up (annual cycles)
    dt_days    = 1       ! [d] chion step (divides the 360-day year)
    trans_sw   = 0.6     ! [1] TOA -> surface shortwave transmissivity (bessi)
    wind_speed = 5.0     ! [m s-1] Constant wind speed (bessi)
    rel_hum    = 0.8     ! [1] Constant relative humidity (bessi)
/

&chion_ant
    model           = "pdd"                          ! Snowpack model: "itm", "bessi" or "pdd"
    nml_bessi       = "bessi"                        ! Namelist group holding the BESSI parameters
    nml_pdd         = "pdd_chion_ant"                ! PDD parameters (chion's own group)
    nml_itm         = "itm"                          ! Namelist group holding the ITM parameters
    nml_const       = "chion_const_ant"              ! Namelist group holding chion's own constants
    phys_const_file = "input/chion_phys_const.nml"   ! Shared constants, standalone only
    phys_const      = "Earth"                        ! Group within phys_const_file
    restart         = "None"                         ! Restart file, or "None" for a cold start (WP14)
/

&chion_const_ant
    rho_s                              = 315.0           ! [kg m-3] Fresh snow density (constant scheme)
    rho_s_a                            = 109.0           ! [kg m-3] Intercept
    rho_s_b                            = 6.0             ! [kg m-3 K-1] Temperature slope
    rho_s_c                            = 26.0            ! [kg m-3 (m s-1)^-1/2] Wind slope
    fresh_snow_density_scheme          = "constant"      ! "constant" | "parameterized"
    Lv                                 = 2.501e6         ! [J kg-1] Latent heat of vaporization
    cp_air                             = 1003.0          ! [J kg-1 K-1] Heat capacity of air
    latent_heat_flux_ratio             = 1.0             ! [1] Scaling of the turbulent latent flux
    seb_scheme                         = "semix"         ! Longwave only: "bessi" | "semix" (absorbed with eps_snow / eps_ice)
    turbulent_flux_scheme              = "semix"         ! Sensible and latent heat: "bessi" | "semix" | "climberx"
    D_sh                               = 10.0            ! [W m-2 K-1] Sensible heat exchange coefficient (bessi)
    z0m_snow                           = 0.0024          ! [m]  Momentum roughness length, snow
    z0m_ice                            = 0.002           ! [m]  Momentum roughness length, ice
    zm_to_zh                           = 0.13533528      ! [1]  Heat/momentum roughness ratio, exp(-2)
    z_sfl                              = 100.0           ! [m]  Surface layer height
    karman                             = 0.4             ! [1]  von Karman constant
    R_dry                              = 287.058         ! [J kg-1 K-1] Gas constant of dry air
    l_neutral                          = .FALSE.         ! [1]  Force neutral stratification?
    l_dew                              = .TRUE.          ! [1]  Allow dew/frost deposition?
    climberx_qsat                      = "climberx"      ! Saturation humidity: "climberx" (q_sat_i) | "bessi"
    semix_karman                       = 0.4             ! [1]  von Karman constant
    semix_surface_height               = 10.0            ! [m]  Reference height of air temperature and wind
    semix_z0m_snow                     = 0.001           ! [m]  Momentum roughness length, snow
    semix_z0m_ice                      = 0.01            ! [m]  Momentum roughness length, bare ice
    semix_zm_to_zh                     = 10.0            ! [1]  z0m/z0h
    semix_sensible_exchange_factor     = 2.5             ! [1]  Sensible-heat exchange factor (MAR-calibrated)
    semix_stable_coefficient           = 40.0            ! [1]  b in the stable damping 1/(1 + b*Ri) (MAR-calibrated)
    semix_latent_exchange_factor       = 1.0             ! [1]  Latent-heat exchange factor
    alpha_dry                          = 0.81            ! [1] Dry snow albedo (upper bound)
    alpha_wet                          = 0.70            ! [1] Wet snow albedo (lower bound)
    alpha_ice                          = 0.40            ! [1] Bare ice albedo
    max_lwc_albedo                     = 0.10            ! [1] LWC at which the albedo reaches alpha_wet
    albedo_scheme                      = "dynamic"       ! "constant" | "dynamic" | "prescribed" | "semix" | "aging"
    aging_cold_timescale_days          = 20.0            ! [d] Aging e-folding time, surface below T0 (albedo_scheme = "aging")
    aging_melting_timescale_days       = 2.0             ! [d] Aging e-folding time, surface at T0
    aging_snowfall_ref                 = 10.0            ! [kg m-2] e-folding snowfall of the aging albedo's rejuvenation
    swe_crit_albedo                    = 10.0            ! [kg m-2] Column SWE of full snow cover (0 = off: any snow covers)
    alpha_land                         = 0.2             ! [1] Background albedo of a land column (H_ice = 0)
    c_fsnow                            = 10.0            ! [1] SEMIX snow cover tanh(h_snow/(c_fsnow*z0m_ice)) (CLIMBER-X)
    c_fsnow_orog                       = 2e-4            ! [1] SEMIX orography h_snow/(h_snow + c_fsnow_orog*z_sur_std)
    frac_vu                            = 0.45            ! [1]  Visible+UV fraction of incoming solar
    alb_snow_vis_new                   = 0.99            ! [1]  Fresh-snow visible diffuse albedo
    alb_snow_nir_new                   = 0.65            ! [1]  Fresh-snow near-IR diffuse albedo
    snow_grain_fresh                   = 50.0            ! [um] Fresh snow grain size
    snow_grain_old                     = 1000.0          ! [um] Aged snow grain size
    d_alb_age_vis                      = 0.05            ! [1]  Visible aging albedo reduction
    d_alb_age_nir                      = 0.25            ! [1]  Near-IR aging albedo reduction
    f_age_t                            = 0.1             ! [K-1] Dry-snow temperature aging factor
    dT_age                             = 0.0             ! [K]  Aging temperature offset
    snow_0                             = 1.0             ! [kg m-2 d-1] Critical snowfall rate for grain aging
    snow_1                             = 0.5             ! [1]  Snowfall-rate aging exponent
    w_snow_dust                        = 10.0            ! [kg m-2] SWE melt that doubles dust concentration
    dust_con_scale                     = 1.0             ! [1]  Dust concentration scaling
    semix_snow_albedo                  = "dang"          ! "warren_wiscombe" | "dang" (CLIMBER-X default: Dang 2015)
    dalb_snow_vis                      = 0.0             ! [1]  Visible snow albedo offset (Dang)
    dalb_snow_nir                      = 0.0             ! [1]  Near-IR snow albedo offset (Dang)
    k_sigma_orog                       = 0.0             ! [1]  Orographic albedo reduction scale (Dang)
    sigma_orog_crit                    = 1000.0          ! [m]  Orographic roughness scale (Dang)
    eps_air                            = 0.80            ! [1] Emissivity of air (graybody longwave)
    longwave_scheme                    = "cloud_proxy"   ! Downwelling longwave if not prescribed: "graybody" | "cloud_proxy"
    lw_emissivity_base                 = 0.624           ! [1]     Cloud proxy: emissivity at T0, clear sky
    lw_emissivity_temperature_slope    = 0.0032          ! [K-1]   Cloud proxy: emissivity per K of T_air - T0
    lw_emissivity_cloud_slope          = 0.613           ! [1]     Cloud proxy: emissivity per unit cloudiness
    lw_clear_sky_transmissivity        = 0.85            ! [1]     Cloud proxy: clear-sky SW transmissivity at sea level
    lw_clear_sky_transmissivity_per_km = 0.075           ! [km-1]  Cloud proxy: its increase with surface height
    lw_night_cloud_fraction            = 0.389           ! [1]     Cloud proxy: cloudiness without a daily TOA
    eps_snow                           = 0.98            ! [1] Emissivity of snow
    eps_ice                            = 0.98            ! [1] Emissivity of bare ice (seb_scheme = "semix" only)
    sigma_sb                           = 5.670373e-8     ! [W m-2 K-4] Stefan-Boltzmann constant
    low_density_densification          = "bessi"         ! "bessi" | "htessel" (selects the rho<550 branch only)
/

&pdd_chion_ant
    ddf_snow            = 3.0      ! [kg m-2 K-1 d-1] Degree-day factor for snow
    ddf_ice             = 8.0      ! [kg m-2 K-1 d-1] Degree-day factor for ice
    refreezing_fraction = 0.6      ! [1] Refreezing capacity per unit snowpack
    temperature_sigma   = 5.0      ! [K] Std dev of unresolved temperature variability
    H_snow_max          = 5000.0   ! [kg m-2] Snowpack cap; the excess is converted to ice
    pdd_method          = "cg05"   ! PDD integral: "cg05" (Calov and Greve, 2005) or "simple"
    firn_fac            = 0.0266   ! [K (mm w.e. yr-1)-1] Firn warming per annual refreezing
/

&marine_shelf_ant
    bmb_method      = "quad-nl"                                                          ! "pico", "anom", "lin", "quad", "quad-nl", "*-slope"
    tf_method       = 1                                                                  ! 1: T_shlf-T_fp_shlf, 2: dT_shlf (needed by bmb_method="anom")
    interp_depth    = "shlf"                                                             ! "shlf", "bed", "const"
    interp_method   = "interp"                                                           ! "mean", "layer", "interp" ! Same method is used for salinity
    find_ocean      = True                                                               ! Find which points are connected to open ocean (ie, ignore subglacial lakes)
    restart         = "None"                                                             ! Load fields from a restart file?
    extrap_shlf     = False                                                              ! Extrapolate ocean front values into the shelf
    mask_ocean      = "zone:open_ocean"                                                  ! mask_ocn_ref: ocean (else land)
    mask_deep_ocean = "~region:Antarctica | zone:open_ocean | zone:shelf_break_buffer"   ! mask_ocn_ref: deep ocean (c_deep), over ocean
    mask_pico_deep  = "none"                                                             ! pico only (bmb_method="pico"): bmb averaged with c_deep there, e.g. "region:Antarctica & zone:shelf_break_buffer"
    bmb_max         = 0.0                                                                ! [m/a] Maximum allowed bmb value (eg, for no refreezing, set bmb_max=0.0)
    c_deep          = -10.0                                                              ! [m/a] Melt rate in deep ocean, should be negative but not huge
    depth_deep      = 2000.0                                                             ! [m] Depth at which deep ocean is assumed
    depth_const     = 2000.0                                                             ! [m] Constant shelf depth for interp_depth=const
    depth_min       = 1100.0                                                             ! [m] interp_method=mean, min depth to include
    depth_max       = 1500.0                                                             ! [m] interp_method=mean, max depth to include
    lambda1         = -0.0575                                                            ! [degC PSU−1] Liquidus slope
    lambda2         = 0.0832                                                             ! [degC] Liquidus intercept
    lambda3         = 7.59e-4                                                            ! [degC m−1] Liquidus pressure coefficient
    gamma_lin       = 630.0                                                              ! [m/yr] Linear heat excange velocity. Favier et al., (2019) suggest 630.
    gamma_quad      = 11100.0                                                            ! [m/yr] Quadratic heat exchange velocity. Jourdain et al. (2020) suggest 11100.
    gamma_quad_nl   = 14500.0                                                            ! [m/yr] Quadratic non-local heat exchange velocity. Jourdain et al. (2020) suggest 14500.
    gamma_prime     = 100.0                                                              ! [-] Scalar when '*-slope' method is used
    kappa_grz       = 10.0                                                               ! [m/a K-1] Heat flux coefficient [kappa*dT]
    c_grz           = 1.0                                                                ! [-] bmb_ref scalar [c_grz*bmb_ref]
    f_grz_shlf      = 10.0                                                               ! [-] Ratio of grz melt to shelf melt
    grz_length      = 16.0                                                               ! [km] Length scale of assumed grounding zone
    use_obs         = False                                                              ! Load obs for bmb_ref
    obs_path        = "fesmdata/{domain}/{grid_name}/{grid_name}_BasalMelt-Rignot2013.nc"
    obs_name        = "bmelt_eq_reese"
    obs_scale       = 1.0                                                                ! [-] bmb_ref = obs_scale*bmb_obs
    obs_lim         = 100.0                                                              ! [m/yr] Maximum magnitude of bmb_ref
/

&shelf_corr_ant
    basins        = "Zwally2012"   ! basin ids: <set>, <set>.group, None or domain (one basin)
    corr_method   = "tf"           ! none, tf or bmb: corrections by region
    corr_names    = "b1" "b12" "b14" "b15"
    corr_values   = 0.3 0.3 -1.5 0.0
    corr_b1       = "Zwally2012:1"
    corr_b12      = "Zwally2012:12"
    corr_b14      = "Zwally2012:14"
    corr_b15      = "Zwally2012:15"
    tf_correction = False          ! no grid-specific tf file: mshlf runs from the remapped climate forcing
    tf_path       = "ice_data/{domain}/{grid_name}/{grid_name}_OCEAN_ISMIP6_J20.nc"
    tf_name       = "dT_nl"
/

&yelmo_ant
    domain           = "None"     ! User par file must override this
    grid_name        = "None"     ! User par file must override this
    grid_path        = "fesmdata/{domain}/{grid_name}/{grid_name}_grid.nc"
    experiment       = "None"     ! "None", "EISMINT1", "MISMIP3D"  to apply special boundary conditions
    mask_border      = "auto"     ! Ice mask on the domain border: "auto" (by domain), "none", "fixed", "dynamic"
    nml_ytopo        = "ytopo_ant"
    nml_ycalv        = "ycalv_ant"
    nml_ydyn         = "ydyn_ant"
    nml_ytill        = "ytill_ant"
    nml_ymat         = "ymat_ant"
    nml_ytrc         = "ytrc_ant"
    nml_ytherm       = "ytherm_ant"
    nml_yhyd         = "yhyd_ant"
    nml_masks        = "yelmo_masks_ant"
    nml_init_topo    = "yelmo_init_topo_ant"
    nml_data         = "yelmo_data_ant"
    restart          = "None"
    restart_z_bed    = True       ! Take z_bed (and z_bed_sd) from restart file
    restart_H_ice    = True       ! Take H_ice from restart file
    restart_relax    = 1e3        ! [yrs] Years to relax from restart=>input topography
    log_timestep     = False
    log_mb_check     = False      ! Print global mass-budget check (residual) every timestep
    disable_kill     = False      ! Disable automatic kill if unstable
    zeta_scale       = "exp"      ! "linear", "exp", "tanh"
    zeta_exp         = 2.0
    nz_aa            = 10         ! Vertical resolution in ice
    dt_method        = 2          ! 0: no internal timestep, 1: adaptive, cfl, 2: adaptive, pc
    dt_min           = 0.1        ! [a] Minimum timestep
    cfl_max          = 0.5        ! Maximum value is 1.0, lower will be more stable
    pc_method        = "AB-SAM"   ! "FE-SBE", "AB-SAM", "HEUN"
    pc_controller    = "PI42"     ! PI42, H312b, H312PID, H321PID, PID1
    pc_use_H_pred    = True       ! Use predicted H_ice instead of corrected H_ice
    pc_filter_vel    = True       ! Use mean vel. solution of current and previous timestep
    pc_n_redo        = 5          ! How many times can the same iteration be repeated (when high error exists)
    pc_tol           = 1.0        ! [1/a] Redo the timestep when pc_eta > pc_tol; pc_eta = RMS of tau/(1 m + 0.01 H) over the pc mask without the pc_eta_trim largest, tau = pc truncation error [m/a]
    pc_eps           = 0.02       ! [1/a] Target pc_eta of the adaptive timestep (dt_method=2), must be <= pc_tol
    pc_cfl_max       = 0.5        ! Courant-number cap on the pc adaptive timestep (dt_method=2)
    pc_rho_max       = 2.0        ! Maximum growth factor dt_new/dt per step of the pc adaptive timestep (dt_method=2)
    pc_eta_H_min     = 10.0       ! [m] Thinner ice is not included in the pc error norm
    pc_eta_u_min     = 0.0        ! [m/yr] Slower ice is not included in the pc error norm
    pc_eta_trim      = 0.0        ! [--] Fraction of points with the largest errors left out of the pc error norm
    write_metrics    = False      ! Write numerics/speed metrics to yelmo_metrics.nc
    write_metrics_dt = 100.0      ! [yr] Output cadence for yelmo_metrics.nc
/

&ytopo_ant
    solver          = "impl-lis"   ! "expl", "impl-lis"
    grad_lim        = 0.05         ! [m/m] Maximum allowed sloped in gradient calculations (dz/dx,dH/dx)
    grad_lim_zb     = 0.5          ! [m/m] Maximum allowed sloped in bed gradient (dzb/dx)
    slope_bg_x      = 0.0          ! [m/m] Uniform background slope in x added to dzs/dx and dzb/dx, not contained in z_srf/z_bed (periodic domains with a tilted geometry)
    slope_bg_y      = 0.0          ! [m/m] Uniform background slope in y added to dzs/dy and dzb/dy, not contained in z_srf/z_bed (periodic domains with a tilted geometry)
    front_subgrid   = "marine"     ! Subgrid ice fronts: "none" (binary f_ice), "floating", "marine" (floating + marine-grounded)
    front_H_eff_min = 50.0         ! [m] Minimum effective thickness of front cells (front_subgrid)
    front_dHdx      = 0.0          ! [m/m] Thickness gradient assumed at a full front (front_subgrid)
    use_bmb         = True         ! Use basal mass balance in mass conservation equation
    topo_fixed      = False        ! Keep ice thickness fixed, perform other ytopo calculations
    topo_rel        = 0            ! 0: No relaxation; 1: relax shelf; 2: relax shelf + gl; 3: all points
    topo_rel_tau    = 10.0         ! [a] Time scale for relaxation
    topo_rel_field  = "H_ref"      ! "H_ref" or "H_ice_n"
    bmb_gl_method   = "pmpt"       ! "fcmp": flotation; "fmp": full melt; "pmp": partial melt; "nmp": no melt
    gl_sep          = 1            ! 1: binary f_grnd, linear f_grnd_acx/acy; 3: grounded area of H_grnd bilinear between cell centres (Leguy et al., 2021)
    gz_nx           = 15           ! [-] Subgrid points per side (gz_nx*gz_nx) of the grounding-zone melt, bmb_gl_method = "pmpt"
    dist_grz        = 200.0        ! [km] Radius to consider part of "grounding-line zone" (grz)
    gz_Hg0          = 0.0          ! Grounding zone, limit of penetration of bmb_grnd
    gz_Hg1          = 0.0          ! Grounding zone, limit of penetration of bmb_shlf
    dmb_method      = 0            ! 0: no subgrid discharge, 1: subgrid discharge on
    dmb_alpha_max   = 60.0         ! [deg] Maximum angle of slope from coast at which to allow discharge
    dmb_tau         = 100.0        ! [yr]  Discharge timescale
    dmb_sigma_ref   = 300.0        ! [m]   Reference bed roughness
    dmb_m_d         = 3.0          ! [-]   Discharge distance scaling exponent
    dmb_m_r         = 1.0          ! [-]   Discharge resolution scaling exponent
    fmb_method      = 0            ! 0: prescribe boundary field fmb_shlf; 1: calculate proportional fmb~bmb_shlf.
    fmb_scale       = 1.0          ! Scaling of fmb ~ scale*bmb, scale=10 suggested by Pollard and DeConto (2016)
    fmb_lambda      = 1.0          ! fmb_method=3: scaling of the Rignot et al. (2016) frontal melt (ISMIP7 protocol)
/

&ycalv_ant
    use_lsf           = True      ! use level-set method
    lsf_method        = "snap"    ! "snap" (legacy neighbour-snap) or "redist" (Sussman/Osher)
    dt_lsf            = -1        ! [yr] lsf update timescale. If negative: no reset.
    lsf_redist_n_iter = 5         ! Sussman/Osher LSF redistancing iterations. redist mode only.
    calv_flt_method   = "threshold"   ! "zero", "simple", "flux", "vm-l19", "kill", "threshold" (calib-cf round 4; the base has equil)
    calv_grnd_method  = "zero"   ! "zero", "stress-b12" (calib-cf round 4; the base has equil)
    H_min_grnd        = 0.0   ! [m] Minimum ice thickness at grounded margin (thinner ice is ablated) - helps with stability, smaller value will lead to more precise summit (calib-cf round 4; the base has 5)
    H_min_flt         = 0.0   ! [m] Minimum ice thickness at floating margin (thinner ice is ablated) - helps with stability (calib-cf round 4; the base has 5)
    H_min_tau         = 10.0      ! [yr] Timescale for removing margin ice thinner than H_min_grnd/H_min_flt and isolated partial cells
    sd_min            = 100.0     ! [m] calv_grnd(z_bed_sd <= sd_min) = 0.0
    sd_max            = 500.0     ! [m] calv_grnd(z_bed_sd >= sd_max) = calv_max
    calv_grnd_max     = 0.0       ! [m/a] Maximum grounded calving rate from high stdev(z_bed)
    calv_tau          = 1.0       ! [a] Characteristic calving time
    calv_thin         = 30.0      ! [m/yr] Calving rate to apply to very thin ice
    k2                = 3.2e9     ! [m yr] eigen calving scaling factor (Albrecht et al, 2021 recommend 1e17 m s == 3.2e9 m yr)
    w2                = 0.0       ! Weighting coefficient of 2nd principal strain/stress
    kt_ref            = 0.0025    ! [m yr-1 Pa-1] vm-l19 calving scaling parameter
    kt_deep           = 0.1       ! [m yr-1 Pa-1] vm-l19 calving scaling parameter for deep ocean
    tau_ice_flt       = 85.0e3   ! [Pa] Ice strength failure, floating fronts (vm-m16) (calib-cf round 4; the base has 100e3)
    tau_ice_grnd      = 85.0e3   ! [Pa] Ice strength failure, marine-grounded fronts (vm-m16) (calib-cf round 4; the base has 100e3)
    Hc_ref_flt        = 200.0     ! [m] Calving limit in ice thickness (thinner ice calves)
    Hc_ref_grnd       = 100.0     ! [m] Calving limit in grounded ice thickness (thinner ice calves)
    Hc_ref_thin       = 50.0      ! [m] Reference ice thickness for thin ice calving
    Hc_deep           = 500.0     ! [m] Calving limit in ice thickness (thinner ice calves)
    zb_deep_0         = -1000.0   ! [m] Bedrock elevation to begin transition to deep ocean
    zb_deep_1         = -1500.0   ! [m] Bedrock elevation to end transition to deep ocean
    zb_sigma          = 0.0       ! [m] Gaussian filtering of bedrock for calving transition to deep ocean
/

&ydyn_ant
    solver               = "diva"                                                              ! "fixed", "sia", "ssa", "hybrid", "diva", "diva-noslip", "l1l2", "l1l2-noslip"
    uz_method            = 3                                                                   ! 1: aa-staggering, 2: strain-rate-on-nodes, 3: jacobian
    visc_method          = 1                                                                   ! 0: constant visc=visc_const, 1: dynamic viscosity
    visc_const           = 1e7                                                                 ! [Pa a] Constant value for viscosity (if visc_method=0)
    beta_method          = 3                                                                   ! 0: constant beta; 1: linear (beta=cb/u0); 2: psuedo-plastic-power; 3: Regularized Coulomb
    beta_const           = 1e3                                                                 ! [Pa a m−1] Constant value of basal friction coefficient to be used
    beta_q               = 0.2                                                                 ! Dragging law exponent
    beta_u0              = 100.0                                                               ! [m/a] Regularization term for regularized Coulomb law (beta_method=3)
    beta_gl_scale        = 2                                                                   ! 0: beta*beta_gl_f, 1: H_grnd linear scaling, 2: Zstar scaling
    beta_gl_stag         = 3                                                                   ! 0: simple staggering, 1: Upstream beta at gl, 2: downstream, 3: f_grnd_ac scaling, 4: vel weighting
    beta_gl_f            = 1.0                                                                 ! [-] Scaling of beta at the grounding line (for beta_gl_scale=0)
    taud_gl_method       = 0                                                                   ! 0: binary, no subgrid, 1: Two-sided gradient
    H_grnd_lim           = 500.0                                                               ! [m] For beta_gl_scale=1, reduce beta linearly between H_grnd=0 and H_grnd_lim
    beta_min             = 100.0                                                               ! [Pa a m-1] Minimum value of beta allowed for grounded ice (for stability)
    eps_0                = 1e-6                                                                ! [1/a] Regularization term for effective viscosity - minimum strain rate
    frz_scale            = True                                                                ! Reduce sliding where the bed is below the pressure melting point: beta*f**(-q), f=frz_min+(1-frz_min)*exp(T_prime_b/frz_efold)
    frz_efold            = 3.0                                                                 ! [K] e-folding temperature of the sliding speed (at fixed basal stress, any friction law)
    frz_min              = 1e-3                                                                ! [-] Minimum sliding-speed factor for frozen beds
    ssa_solver           = "energy"                                                            ! "residual" | "energy"
    ssa_lis_opt_residual = "-i minres -p jacobi -maxiter 100 -tol 1.0e-2 -initx_zeros false"   ! See Lis library !-omp_num_threads 2
    ssa_lis_opt_energy   = "-i cg -p ssor -maxiter 200 -tol 1.0e-3 -initx_zeros false"         ! SPD => CG; tol 1e-3 is below the Picard tolerance ssa_iter_conv
    ssa_lat_bc           = "all"                                                               ! "all", "marine", "floating", "none"
    ssa_vel_lim_method   = "drag"                                                              ! "clip": clip each velocity component at ssa_vel_max; "drag": smooth speed-limit drag on all free faces, tau = ssa_vel_lim_tau at ssa_vel_max, components also clipped at ssa_vel_max
    ssa_vel_max          = 10000.0                                                             ! [m a-1] Velocity limit: clip value (both methods); "drag": also the speed at which the limit drag reaches ssa_vel_lim_tau
    ssa_vel_lim_tau      = 1e5                                                                 ! [Pa] Speed-limit drag at ssa_vel_max (ssa_vel_lim_method="drag")
    ssa_iter_max         = 5                                                                   ! Number of maximum allowed iterations over ssa to converge on vel. solution
    ssa_iter_rel         = 0.7                                                                 ! [--] Relaxation fraction [0:1] to stabilize ssa iterations
    ssa_iter_conv        = 1e-2                                                                ! [--] L2 relative error convergence limit to exit ssa iterations
    taud_lim             = 2e5                                                                 ! [Pa] Maximum allowed driving stress
    neff_nxi             = 0                                                                   ! Subgrid interpolation of hyd%N onto dyn%N_eff. 0: none, 1: Gaussian quadrature, >1: nxi x nxi subgrid.
/

&ytill_ant
    method    = 1        ! -1: set externally; 1: calculate cb_ref online
    scale_zb  = 2   ! 2: exp with z0/z1 below (calib-cf; the base has 0: none)
    scale_sed = 0        ! 0: none, 1: min(cb_zb,cb_sed), 2: cb_zb*(lambda_sed*f_sed), 3: 2 but no lower limit
    is_angle  = False    ! cb_ref is a till strength angle?
    n_sd      = 10       ! Number of samples over z_bed_sd field
    f_sed     = 1.0      ! Scaling reduction for thick sediments
    sed_min   = 5.0      ! [m] Sediment thickness for no reduction in friction
    sed_max   = 15.0     ! [m] Sediment thickness for maximum reduction in friction
    z0        = -400.0   ! [m] Bedrock rel. to sea level, lower limit
    z1        = 0.0      ! [m] Bedrock rel. to sea level, upper limit
    cf_min    = 0.01     ! [-- or deg] Minimum value of cf
    cf_ref    = 0.05   ! [-- or deg] Reference/const/max value of cf (calib-cf; the base has 0.1)
/

&yhyd_ant
    method_til                     = 1                       ! 0=NONE 1=BUCKET
    method_transport               = 0                       ! 0=NONE 1=K24
    W_til_max                      = 2.0                     ! [m]   was ytherm.H_w_max
    mask_bc                        = 2                       ! 0=ZERO 1=IMPOSED 2=MIRROR
    W_til_bc                       = 0.0                     ! [m]
    bkt_N_closure                  = 2                       ! 0=CONST 1=OVERBURDEN 2=MARINE 3=TILL 4=TWO_VALUE
    bkt_till_rate                  = 1e-3                    ! [m/a]  was ytherm.till_rate
    bkt_floating_mode              = 0                       ! 0=ZERO 1=MARGIN_FILL (legacy saturate floating+margin ring)
    const_N                        = 1.0e7                   ! [Pa] N_CLOSURE_CONST (legacy yneff.const)
    marine_p                       = 1.0
    marine_rho_sw                  = 1028.0                  ! [kg/m3] ignored by yelmo: overwritten by yelmo_phys_const.nml rho_sw (as are rho_ice, rho_w, g)
    till_N0                        = 1000.0                  ! legacy yneff.N0
    till_delta                     = 0.04                    ! legacy yneff.delta
    till_e0                        = 0.69                    ! legacy yneff.e0
    till_Cc                        = 0.12                    ! legacy yneff.Cc
    two_value_delta                = 0.02
    k24_substrate_type             = 2                       ! 0=HARD 1=SOFT 2=MIXED (binary, z_bed<-1000) 3=MIXED_SMOOTH (ramp); 4=EXTERNAL not supported by yelmo (Fortran-only; builds kappa)
    k24_kappa_z_hard               = -500.0                  ! MIXED_SMOOTH: z_bed at/above which the bed is hard, kappa = 0 [m]
    k24_kappa_z_soft               = -1500.0                 ! MIXED_SMOOTH: z_bed at/below which the bed is soft, kappa = 1 [m]
    k24_flux_solver                = 3                       ! 0=RECURSIVE 1=ITERATIVE 2=TOPOSORT (GDS_WARNER only) 3=TAPED (default)
    k24_routing_scheme             = 0                       ! 0=WARNER 1=GDS_WARNER (original K24) 2=QUINN 3=TARBOTON 4=MODIFIED_TARBOTON 5=GDS_TARBOTON
    k24_quinn_original             = False                   ! QUINN only: Quinn et al.'s own slope x contour-length weights
    k24_fill_algorithm             = -1                      ! -1=AUTO (JACOBI for GDS schemes, else PRIORITY_FLOOD) 0=JACOBI 1=LOWEST_NEIGHBOUR 2=PRIORITY_FLOOD
    k24_priority_flood_epsilon     = 1.0                     ! [Pa] potential step across a filled pit/flat
    k24_q_conversion               = -1                      ! -1=AUTO (FACE_AVERAGE for WARNER, else OUTFLOW) 0=OUTFLOW 1=FACE_AVERAGE
    k24_dissipation_discretization = -1                      ! -1=AUTO (FACE for WARNER, else CELL) 0=CELL 1=FACE
    k24_friction_discretization    = 0                       ! 0=CELL (tau_b*|u_b|) 1=STAGGERED (C-grid velocities)
    k24_friction_quadrature        = False                   ! STAGGERED only: Yelmo's qb_method=2 Gauss-point heat
    k24_friction_u_floor           = 3.168808781402895e-11   ! [m/s] = 1e-3 m/yr, STAGGERED beta floor
    k24_toposort_allow_cycles      = False                   ! TopologicalPsiOut(allow_cycles=...)
    k24_N_ub_coupled               = True                    ! DIVA velocity iteration re-evaluates K24 N from u_b (hydro_N_from_ub); False = N once per step
    k24_drainage_mode              = 0                       ! 0=BOTH 1=EFFICIENT_ONLY 2=INEFFICIENT_ONLY
    k24_water_thickness_algorithm  = 0                       ! 0=DARCY_WEISBACH 1=LAMINAR 2=AREAL_CONDUIT
    k24_gradient_convention        = 0                       ! 0=MEAN 1=LOCAL (Darcy-Weisbach / laminar closures only)
    k24_sliding_law                = 0                       ! 0=NO_FRICTION 1=WEERTMAN 2=POWER_PLASTIC 3=REG_COULOMB 4=PRESCRIBED_FIELD 5=REG_COULOMB_FIELD 6=SHAKTI_REG_COULOMB
    k24_glen_n                     = 3.0                     ! n, Glen's flow-law exponent
    k24_latent_heat_water          = 3.35e5                  ! L_w [J/kg]; overridden by yelmo L_ice (phys_const)
    k24_bed_bump_height            = 0.1                     ! h_b, bed obstacle height [m]
    k24_flux_W_exponent            = 1.25                    ! alpha = 5/4
    k24_flux_grad_exponent         = 1.5                     ! beta  = 3/2
    k24_friction_factor            = 0.1                     ! f, Darcy-Weisbach friction factor
    k24_till_factor                = 1.1                     ! F_till
    k24_critical_discharge         = 1.0                     ! Q_c [m3/s]
    k24_H0_efficient               = 0.1                     ! H_0 [m]
    k24_conduit_spacing            = 1.0e4                   ! l_c, conduit spacing [m]
    k24_coupling_length_kamb86     = 10.0                    ! Kamb & Echelmeyer (1986) coupling length / ice thickness; 0 disables the smoothing entirely
    k24_water_viscosity            = 1.8e-3                  ! water_viscosity [Pa s] = 1.8e-3 per year
    k24_min_pressure_fraction      = 0.02                    ! sigmat        (KORI-ULB: 0.02)
    k24_W_min                      = 1.0e-8                  ! Wmin  [m]     (KORI-ULB: 1.0e-8)
    k24_W_max                      = 0.015                   ! Wmax  [m]     (KORI-ULB: 0.015)
    k24_q_min                      = 0.0                     ! q_min [m2/s]
    k24_q_max                      = 1.0e30                  ! q_max [m2/s]  (KORI-ULB: 3.168808781402895e-3 = 1e5 per year)
    k24_fill_iters                 = 10                      ! fill_iters
    k24_max_psi_out_calls          = 100000                  ! max_psi_out_calls
    k24_dissipation_melt           = True                    ! add |q*grad(phi0)|/(L_w*rho_w) to the source
    k24_max_dissipation_iters      = 20                      ! max_dissipation_iters
    k24_dissipation_rtol           = 1.0e-12                 ! dissipation_rtol
    k24_dissipation_verbose        = True                    ! dissipation_verbose
    k24_max_qN_iters               = 20                      ! max_qN_iters        (N-dependent sliding laws)
    k24_qN_rtol                    = 1.0e-8                  ! qN_rtol
    k24_qN_verbose                 = True                    ! qN_verbose
    k24_weertman_C                 = 0.0                     ! WeertmanSlidingLaw.C [Pa (s/m)^q]
    k24_weertman_q                 = 0.3333333333333333      ! WeertmanSlidingLaw.q
    k24_power_plastic_c_till       = 0.0                     ! PowerPlasticSlidingLaw.c_till
    k24_power_plastic_q            = 1.0                     ! PowerPlasticSlidingLaw.q
    k24_power_plastic_u0           = 3.168808781402895e-06   ! PowerPlasticSlidingLaw.u0 [m/s] = 100 m/yr
    k24_reg_coulomb_c_till         = 0.0                     ! RegularizedCoulombSlidingLaw.c_till
    k24_reg_coulomb_q              = 0.3333333333333333      ! RegularizedCoulombSlidingLaw.q
    k24_reg_coulomb_u0             = 3.168808781402895e-06   ! RegularizedCoulombSlidingLaw.u0 [m/s] = 100 m/yr
    k24_shakti_C                   = 0.0                     ! ShaktiRegularizedCoulombSlidingLaw.C
    k24_shakti_n                   = 3.0                     ! ShaktiRegularizedCoulombSlidingLaw.n
    k24_shakti_lambda_coeff        = 1.5                     ! lambda = coeff * A_glen
/

&ymat_ant
    rf_method         = 1           ! -1: set externally; 0: rf_const everywhere; 1: standard function
    rf_const          = 1e-18       ! [Pa^-3 a^-1]
    rf_use_eismint2   = False       ! Only applied for rf_method=1
    rf_with_water     = False       ! Only applied for rf_method=1, scale rf by water content?
    n_glen            = 3.0         ! Glen flow law exponent
    visc_min          = 1e3         ! [Pa a] Minimum allowed viscosity
    de_max            = 100.0       ! [a-1]  Maximum allowed effective strain rate (high: no cap in most cases; only limits strain heating and mat viscosity)
    enh_method        = "shear3D"   ! "simple","shear2D", "shear3D", "paleo-shear"
    enh_shear         = 1.0
    enh_stream        = 1.0
    enh_shlf          = 0.5
    enh_umin          = 50.0        ! [m/yr] Minimum transition velocity to enh_stream (enh_method="paleo-shear")
    enh_umax          = 500.0       ! [m/yr] Maximum transition velocity to enh_stream (enh_method="paleo-shear")
    tracer_method     = "expl"      ! "expl", "impl": used for age and 'paleo-shear' enh fields
    tracer_impl_kappa = 1.5         ! [m2 a-1] Artificial diffusion term for implicit tracer solving
/

&ytherm_ant
    method          = "enth"       ! "enth","temp","robin","robin-cold","linear","fixed"
    qb_method       = 2            ! 1: faces, 2: faces to quadrature nodes, 3: simple-stagger, 4: quadrature (1, 2: energy-consistent)
    dt_method       = "FE"         ! "FE", "AB", "SAM"
    advecxy_order   = 2            ! Horizontal advection order: 1=upwind, 2=flux-limited 2nd-order upwind
    advecxy_cfl     = 0.5          ! [--] Target Courant number per horizontal-advection sub-step (CFL_safe)
    advecxy_nmax    = 10           ! [--] Max horizontal-advection sub-steps (safety cap; warns if hit)
    gamma           = 1.0          ! [K] Scalar for the pressure melting point decay function
    strain_heating  = "full"       ! "full": from 3D viscosity and strain rate, "sia": SIA approx., "none": no strain heating
    use_const_cp    = False        ! Use specified constant value of heat capacity?
    const_cp        = 2009.0       ! [J kg-1 K-1] Specific heat capacity
    use_const_kt    = False        ! Use specified constant value of heat conductivity?
    const_kt        = 6.62e7       ! [J a-1 m-1 K-1] Thermal conductivity [W m-1 K-1 * sec_year] => [J a-1 m-1 K-1]
    enth_cr         = 1e-3         ! [--] Conductivity ratio for temperate ice (kappa_temp     = enth_cr*kappa_cold)
    omega_max       = 0.01         ! [--] Maximum allowed water content fraction
    H_ice_thin      = 10.0         ! [m] Skip column solver below this thickness (linear profile imposed)
    enth_cp_method  = "integral"   ! Enthalpy heat capacity: "const" (cp_ref) or "integral" (int cp(T) dT); ignored if use_const_cp
    basal_bc_method = "capacity"   ! Grounded basal BC: "capacity" (bmb_grnd* vs freeze-on capacity C) or "wtil" (till-water predictor, deprecated)
    cap_source      = "auto"       ! [capacity] C from: "auto" ("hyd" with water transport, else "till"), "hyd" (hydrology model), "till" (bucket W_til), "water" (water thickness W), "none" (C=0)
    cap_W_floor     = 0.0          ! [m] [capacity, "till"/"water"] floor subtracted from the water thickness
    cap_eps         = 1e-4         ! [m/a ice equiv.] [capacity] C below this counts as a dry bed
    gl_temperate    = True         ! Hold grounded bases next to floating ice or open ocean at the pressure melting point (ocean-wetted bed)
    rock_method     = "active"     ! "equil" (not active bedrock) or "active"
    nzr_aa          = 5            ! Number of vertical points in bedrock
    zeta_scale_rock = "exp-inv"    ! "linear", "exp-inv"
    zeta_exp_rock   = 2.0
    H_rock          = 2000.0       ! [m] Lithosphere thickness
    rhoc_rock       = 2.0e6        ! [J m-3 K-1] Volumetric heat capacity of bedrock (rho*cp)
    kt_rock         = 6.3e7        ! [J a-1 m-1 K-1] Thermal conductivity of bedrock [W m-1 K-1 * sec_year] => [J a-1 m-1 K-1]
/

&yelmo_masks_ant
    regions_group     = "None"               ! the regions come from the driver ([regions])
    basins            = "Zwally2012"         ! <set>, <set>.group, None or domain (one basin)
    mask_ice_dynamic  = "~zone:open_ocean"   ! where ice is dynamic, else no ice (selection expression of the regions)
    mask_ice_fixed    = "none"               ! where ice thickness is prescribed (over mask_ice_dynamic)
    relax             = "none"               ! where ice relaxes to H_ice_ref (ytopo.topo_rel = -1)
    relax_tau         = 0.0                  ! [yr] relaxation timescale there
    border_width      = 0 0                  ! N M: strip of N fixed cells, then M relaxation cells (relax_tau) inward, at the edge of the region where ice is allowed; 0 0 = none
    mask_rmse         = "all"                ! where the error metrics are computed
    dynamic_connected = False                ! keep only the dynamic cells connected to the ice sheet (largest region of present-day, else initial, ice); others no ice
/

&yelmo_init_topo_ant
    init_topo_load  = True
    init_topo_path  = "fesmdata/{domain}/{grid_name}/{grid_name}_TOPO-BedMachine-v6.nc"
    init_topo_names = "H_ice" "z_bed" "z_bed_sd" "z_srf"   ! Ice thickness, bedrock elevation, bedrock noise, surface elevation
    init_topo_state = 0                                    ! 0: from file, 1: ice-free, 2: ice-free, rebounded
    z_bed_f_sd      = 0.0                                  ! Scaling fraction to modify z_bed = z_bed + f_sd*z_bed_sd
    smooth_H_ice    = 0.0                                  ! Smooth ice thickness field at loading time, with sigma=N*dx
    smooth_z_bed    = 0.0                                  ! Smooth bedrock field at loading time, with sigma=N*dx
/

&yelmo_data_ant
    pd_topo_load    = True
    pd_topo_path    = "fesmdata/{domain}/{grid_name}/{grid_name}_TOPO-BedMachine-v6.nc"
    pd_topo_names   = "H_ice" "z_bed" "z_bed_sd" "z_srf"   ! Ice thickness, bedrock elevation, bedrock noise, surface elevation
    pd_tsrf_load    = True
    pd_tsrf_path    = "ice_data/{domain}/{grid_name}/RACMO2.3/{grid_name}_RACMO23-ERAINT-HYBRID_1981-2010.nc"
    pd_tsrf_name    = "T_srf"                              ! Surface temperature (or near-surface temperature)
    pd_tsrf_monthly = True
    pd_smb_load     = True
    pd_smb_path     = "ice_data/{domain}/{grid_name}/RACMO2.3/{grid_name}_RACMO23-ERAINT-HYBRID_1981-2010.nc"
    pd_smb_name     = "smb"                                ! Surface mass balance
    pd_smb_monthly  = True
    pd_vel_load     = True
    pd_vel_path     = "fesmdata/{domain}/{grid_name}/{grid_name}_Velocity-Rignot2011.nc"
    pd_vel_names    = "ux_srf" "uy_srf"                    ! Surface velocity
    pd_age_load     = False
    pd_age_path     = "none"
    pd_age_names    = "age" "depth_iso"                    ! ages of isochrones; depth of isochrones
    pd_age_to_time  = True                                 ! Convert loaded obs isochrone ages [ka] to deposition times [ka] (t_dep = -age)
/

&ytrc_ant
    use_euler         = False                         ! Run the in-tree Eulerian age tracer?
    use_tracer        = False                         ! Run the Lagrangian particle backend (tracer)?
    use_elsa          = False                         ! Run the Lagrangian layer backend (elsa)?
    elsa_restart      = True                          ! On a restart, restore elsa's layers (False: start them fresh)
    t_dep_source      = "euler"                       ! "euler", "trc", "elsa": authoritative deposition-time source
    time_end          = 0.0                           ! [yr] simulation end time for use_elsa (sizes elsa's layer stack; 0.0 = present day)
    calc_age          = False                         ! Calculate the Eulerian age tracer field?
    time_iso          = -11.7, -29.0, -57.0, -115.0   ! [ka] isochrone deposition times
    tracer_method     = "expl"                        ! "expl", "impl": Eulerian age solver
    tracer_impl_kappa = 1.5                           ! [m2 a-1] Artificial diffusion term for implicit age solving
    advecxy_order     = 2                             ! Horizontal advection order: 1=upwind, 2=flux-limited 2nd-order upwind
    advecxy_cfl       = 0.5                           ! [--] Target Courant number per horizontal-advection sub-step
    advecxy_nmax      = 10                            ! [--] Max horizontal-advection sub-steps (safety cap; warns if hit)
    elsa_nml          = "None"                        ! Path to elsa namelist file
    elsa_group        = "None"                        ! Group name within elsa_nml
    tracer_nml        = "None"                        ! Path to tracer namelist file (group "trc")
/

&snapshot_pd_ant
    exp        = ""     ! experiment, the {exp} of its var_defs paths (lgm, piControl, ...)
    monthly    = True   ! tas/pr monthly (else tas = [annual, season], pr annual)
    clim_sigma = 0.0    ! [km] gaussian smoothing of the atmosphere at loading; 0 = none
    ocn_sigma  = 0.0    ! [km] gaussian smoothing of the ocean at loading; 0 = none
    tas_season = ""     ! season of the second tas group: jja | djf; "" = the summer of the hemisphere
    tas        = "racmo23p2_1981_2010_tas"
    pr         = "racmo23p2_1981_2010_pr"
    zs         = "racmo23p2_1981_2010_zs"
    to         = "ismip7_to"
    so         = "ismip7_so"
/

&racmo23p2_1981_2010_tas
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-RACMO2.3p2-1981-2010.nc"
    name     = "t2m"
    units    = "K" "K"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&racmo23p2_1981_2010_pr
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-RACMO2.3p2-1981-2010.nc"
    name     = "pr"
    units    = "kg m-2 yr-1" "mm d-1"
    scaling  = 2.73785e-3 0.0
    time     = 0 0 0 0 1
/

&racmo23p2_1981_2010_zs
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-RACMO2.3p2-1981-2010.nc"
    name     = "z_srf"
    units    = "m" "m"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&ismip7_to
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Ocean-ISMIP7.nc"
    name     = "to"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    fill     = "nearest"
/

&ismip7_so
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Ocean-ISMIP7.nc"
    name     = "so"
    units    = "PSU" "PSU"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    fill     = "nearest"
/
