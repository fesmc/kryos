! Standalone VILMA2 under the PaleoMIST ice history (Gowan et al. 2021; docs/experiment-gowan.md), a runme case of a
! PaleoMIST project (tools/levante/pm_project.sh). Earth "t3": SELEN's Earth of PaleoMIST (calc_sl/data.inc of the
! PANGAEA bundle, model ehgr: 120 km, UM 3.9811e20, LM 3.9811e22 Pa s): three homogeneous layers 0-120, 120-670 km, 670
! km-CMB and the core, rho and mu the volume means of TABOO's 200 s PREM table (pm_prep.jl taboo); vilma.eta==
! 1.0e40,<UM>,<LM>,0.0 (runme: == sets a vector, a comma list alone would be an ensemble) for the other Earths of Gowan's Stokes coefficients (ehgG: LM 3.9811e21).
! Options (runme -p): ctl.file_forcing = "pm_data/pm_force_<F>.nc" (pm_prep.jl: B 80 -> 0 ka steps, A 22.5 ka held, S smoke,
! Bg, Bl, Bm, ...); ctl.z_bed_ref_file, ctl.h_ice_ref_file = "pm_data/pm_ref80.nc" (SELEN's initial state, with
! vilma.equil_time_max = 0); ctl.i_eq = 3 with ctl.rsl_restart_file (the iterated reference, pm_iterref.sh); vilma.scheme
! fe | trap; vilma.sle_subgrid (.false.: the binary ocean load C rsl); vilma.rotation_k_s (0: the model's fluid Love number,
! 0.94349: from the observed flattening); vilma.deg1_frame cm | cf; vilma.rho_ice (the B1 runs of Gowan et al.: 931);
! vilma.equil_time_max [yr] the spin-up cap (0: none); vilma.equil_rate_tol [m/yr] the spin-up's end.

&ctl
 file_forcing = "pm_data/pm_force_B.nc"
 name_ice = "h_ice"
 name_time = "time"
 file_ref = ""
 name_zbed_eq = "z_bed_eq"
 name_hice_ref = "h_ice_ref"
 file_out = "vilma_out.nc"
 file_hor = ""
 write_lossless = .true.
 time_init = -1.0e30
 time_end = 1.0e30
 remap_input = .true.
 name_lon = "lon"
 name_lat = "lat"
 i_eq = 1
 z_bed_ref_file = "pm_data/pm_ref.nc"
 h_ice_ref_file = "pm_data/pm_ref.nc"
 name_z_bed_ref = "z_bed"
 name_h_ice_ref = "H_ice"
 z_bed_eq_file = ""
 h_ice_eq_file = ""
 rsl_restart_file = ""
 name_rsl = "rsl"
 restart_in_file = ""
/
&vilma
 lmax = 170
 scheme = "fe"
 sle_subgrid = .true.
 cfl = 1.0
 rotation = .true.
 rotation_k_s = 0.0
 deg1_frame = "cm"
 rho_ice = 910.0
 rho_water = 1000.0
 earth = "custom"
 n_layer = 4
 r_top = 6371.0e3, 6251.0e3, 5701.0e3, 3480.0e3
 r_bot = 6251.0e3, 5701.0e3, 3480.0e3, 0.0
 rho = 3233.60, 3630.57, 4877.91, 10931.73
 mu = 6.12924e10, 8.83454e10, 2.19481e11, 0.0
 eta = 1.0e40, 3.9811e20, 3.9811e22, 0.0
 rheology = 0, 1, 1, 2
 l_visc_3d = .false.
 pre_spinup_1d = .false.
 equil_rate_tol = 1.0e-5
 equil_time_max = 5.0e5
/
