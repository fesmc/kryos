.SUFFIXES: .f .F .F90 .f90 .o .mod
.SHELL: /bin/sh

# PATH options
srcdir  = src
objdir  = libkryos/include
bindir  = libkryos/bin
testdir = tests

# Command-line options at make call (backend switches: config/common.mk)
debug  ?= 0
openmp ?= 1
pic    ?= 0

# `make` alone prints the targets (the first rule would otherwise be an object
# rule from config/deps.mk).
.DEFAULT_GOAL := usage

## COMPILER CONFIGURATION ##
# Assembled by `configme` from a compiler fragment, a machine fragment and an
# auto-detected netCDF block. The fragment defines the compiler (FC, FFLAGS,
# FFLAGS_OPENMP, DFLAGS_*), netCDF wiring (INC_NC, LIB_NC), and any
# host-specific overrides (e.g. LFLAGS_EXTRA).

<COMPILER_CONFIGURATION>

## SHARED DEPENDENCY WIRING ##
# Pulled in after the compiler/machine fragment so it can reference FFLAGS,
# FFLAGS_OPENMP, LIB_NC and LFLAGS_EXTRA set there. Defines the dependency
# roots, the openmp= / pic= switches, the backend switches (yelmo=1, cism=0,
# ...) and the final LFLAGS.

include config/common.mk

# Determine whether to use normal flags or debugging flags
DFLAGS = $(DFLAGS_NODEBUG)
ifeq ($(debug), 1)
	DFLAGS = $(DFLAGS_DEBUG)
endif

# Debugging flags with profiling output enabled
ifeq ($(debug), 2)
	DFLAGS = $(DFLAGS_PROFILE)
endif

###############################################
##
## kryos sources and their dependencies
##
###############################################

# Generated by configme from the `use`/`module` statements in src/ (rerun
# `configme config`, or `make depend`, after adding a file or a `use`). It sets
# vpath for the source directories, the object list `deps_objs`, and one rule
# per object. A backend and its stub define the same module; common.mk selects
# one by setting <module>_obj before this include.
include config/deps.mk

kryos_objs = $(deps_objs)

# Build info (core-design 7, 11): the module kryos_build_info, written on every
# build by config/build_info.sh (the file changes only when a version does)
# and compiled into the library; kryos_restart uses it for the restart
# manifest. configme deps does not see a generated source: explicit rules.
build_info_src = $(objdir)/kryos_build_info.f90
build_info_obj = $(objdir)/kryos_build_info.o
kryos_objs    += $(build_info_obj)

$(build_info_src): build-info | $(objdir)
	@sh config/build_info.sh $@ $(CURDIR) $(build_info_libs)

$(build_info_obj): $(build_info_src)
	$(FC) $(DFLAGS) $(FFLAGS) -c -o $@ $<

$(objdir)/kryos_restart.o: $(build_info_obj)

build-info:

# One compile rule for every object; vpath (deps.mk) finds the source.
$(objdir)/%.o: %.f90
	$(FC) $(DFLAGS) $(FFLAGS) $(INC_FESMUTILS) $(INC_BACKENDS) -c -o $@ $<

$(objdir)/%.o: %.F90
	$(FC) $(DFLAGS) $(FFLAGS) $(INC_FESMUTILS) $(INC_BACKENDS) -c -o $@ $<

# Object and binary directories, created on demand. Order-only: a directory's
# mtime changes whenever a file in it does, so it must not trigger rebuilds.
$(objdir) $(bindir):
	mkdir -p $@

$(kryos_objs): | $(objdir)

# The build switches the objects in $(objdir) were compiled with (openmp=,
# pic=, debug= and the backend switches; chion's ompstamp, generalised). A
# missing stamp (first build, or a switch changed) is created newer than every
# object, so all of them are rebuilt: switching a backend to its stub replaces
# a module that other objects were compiled against.
buildstamp = $(objdir)/.build-openmp$(openmp)-pic$(pic)-debug$(debug)-$(backend_config)

$(buildstamp): | $(objdir)
	rm -f $(objdir)/.build-*
	touch $@

$(kryos_objs): $(buildstamp)

# kryos objects embed fesm-utils and backend types: rebuild them when one of
# the dependency archives changes, or objects keep a stale type layout
# (fesmc/FastHydrology#10). dep_archives lists only the enabled backends.
$(kryos_objs): $(dep_archives)

###############################################
##
## Dependency checks and builds
##
###############################################

# Sanity check: a missing dependency archive fails early, with instructions,
# instead of as a missing .mod deep in the compile. Each archive has a rule
# that only runs when the file is absent.
dep_missing = echo ""; \
	echo "*** ERROR: $(1) is not built: $@ is missing."; \
	echo "    Build it (openmp=$(openmp) selects the serial or omp variant):"; \
	echo "      $(2)"; \
	echo "    or build every enabled dependency with: make deps-static openmp=$(openmp)"; \
	echo "    (configure it first if needed: configme config <package> -m <machine> -c <compiler>)"; \
	echo ""; \
	exit 1

$(FESMUTILS_ARCHIVE):
	@$(call dep_missing,fesm-utils,make -C $(FESMUTILSROOT) fesmutils-static openmp=$(openmp))

$(LIS_ARCHIVE) $(FFTW_ARCHIVE):
	@$(call dep_missing,fesm-utils external libs (LIS + FFTW; slow, one-time),make -C $(FESMUTILSROOT) libs openmp=$(openmp))

$(YELMO_ARCHIVE):
	@$(call dep_missing,yelmo,make -C $(YELMOROOT) yelmo-static openmp=$(openmp))

$(ISOSTASY_ARCHIVE):
	@$(call dep_missing,FastIsostasy,make -C $(ISOSTASYROOT) isostasy-static openmp=$(openmp))

$(CHION_ARCHIVE):
	@$(call dep_missing,chion,make -C $(CHIONROOT) chion-static openmp=$(openmp))

$(INSOL_ARCHIVE):
	@$(call dep_missing,insol,make -C $(INSOLROOT) static)

deps-check: $(dep_archives)
	@echo "    dependencies present: $(dep_archives)"

# Recursive builds of the dependencies, as in yelmox. Not prerequisites of
# kryos-static: kryos builds against whatever is already built, and the checks
# above say what is missing.
fesmutils-static:
	$(MAKE) -C $(FESMUTILSROOT) fesmutils-static openmp=$(openmp) pic=$(pic)

yelmo-static: fesmutils-static
	$(MAKE) -C $(YELMOROOT) yelmo-static openmp=$(openmp) pic=$(pic)

isostasy-static: fesmutils-static
	$(MAKE) -C $(ISOSTASYROOT) isostasy-static openmp=$(openmp)

chion-static: fesmutils-static
	$(MAKE) -C $(CHIONROOT) chion-static openmp=$(openmp)

# insol is serial (no OpenMP)
insol-static:
	$(MAKE) -C $(INSOLROOT) static

deps-static: fesmutils-static $(backend_static)

# Regenerate config/deps.mk without reconfiguring (needs configme >= 0.16).
CONFIGME ?= configme
depend:
	$(CONFIGME) deps .

###############################################
##
## Library, driver and tests
##
###############################################

# Static library. The archive is a file target, so its mtime only changes when
# an object does (hosts depend on it to rebuild their own objects). It is
# written from scratch: `ar rc` only adds and replaces members, so an object
# that has left the list (e.g. a backend switched to its stub) would stay.
kryos-static: $(objdir)/libkryos.a

$(objdir)/libkryos.a: $(kryos_objs)
	rm -f $@
	ar rc $@ $(kryos_objs)
	ranlib $@
	@echo " "
	@echo "    $(objdir)/libkryos.a is ready."
	@echo " "

# The driver: one program for N domains, a client of the library.
kryos: $(objdir)/libkryos.a | $(bindir)
	$(FC) $(DFLAGS) $(FFLAGS) $(INC_FESMUTILS) -o $(bindir)/kryos.x drivers/kryos.f90 \
		-L${CURDIR}/$(objdir) -lkryos $(LFLAGS)
	@echo " "
	@echo "    $(bindir)/kryos.x is ready."
	@echo " "

# Tests: every tests/test_*.f90 is a program linked against libkryos that
# exits non-zero on failure. `make check` builds and runs them all, except the
# tests that need a backend library switched off (test_skip, config/common.mk).
test_srcs = $(filter-out $(test_skip),$(wildcard $(testdir)/test_*.f90))
test_exes = $(patsubst $(testdir)/%.f90,$(bindir)/%.x,$(test_srcs))

$(bindir)/%.x: $(testdir)/%.f90 $(objdir)/libkryos.a | $(bindir)
	$(FC) $(DFLAGS) $(FFLAGS) $(INC_FESMUTILS) $(INC_BACKENDS) -o $@ $< \
		-L${CURDIR}/$(objdir) -lkryos $(LFLAGS)

check: $(test_exes)
	@failed=0; for t in $(test_exes); do \
	  echo "--- $$t"; \
	  ./$$t || { echo "*** FAILED: $$t"; failed=1; }; \
	done; \
	if [ $$failed -ne 0 ]; then exit 1; fi; \
	echo " "; echo "    make check: all tests passed."; echo " "

.PHONY : build-info usage kryos-static kryos check clean cleanall depend deps-check deps-static \
         fesmutils-static yelmo-static isostasy-static chion-static insol-static
usage:
	@echo ""
	@echo "    * USAGE * "
	@echo ""
	@echo " make kryos-static : $(objdir)/libkryos.a and the .mod files in $(objdir)"
	@echo " make kryos        : $(bindir)/kryos.x, the driver"
	@echo " make check        : builds and runs every tests/test_*.f90"
	@echo " make deps-check   : fails with instructions if a dependency is not built"
	@echo " make deps-static  : builds fesm-utils and the enabled backend libraries"
	@echo " make depend       : regenerates config/deps.mk (configme deps .)"
	@echo " make clean        : removes kryos objects, modules, library and executables"
	@echo " make cleanall     : also cleans the dependency libraries"
	@echo ""
	@echo " Options: debug=1|2, openmp=0|1 (default 1), pic=1"
	@echo " Backends (1 = link the library, 0 = stub that stops at init):"
	@echo "   yelmo=$(yelmo) fastisostasy=$(fastisostasy) chion=$(chion) insol=$(insol)"
	@echo "   cism=$(cism) pism=$(pism) vilma=$(vilma) rembo=$(rembo)"
	@echo ""

clean:
	rm -f $(bindir)/*.x
	rm -f *.x gmon.out $(build_info_src) $(objdir)/*.o $(objdir)/*.mod $(objdir)/*.smod $(objdir)/*.a $(objdir)/*.so $(objdir)/.build-*
	rm -rf *.x.dSYM $(bindir)/*.x.dSYM

# Cleans fesm-utils and the enabled backend libraries.
cleanall: clean
	for d in $(FESMUTILSROOT) $(backend_roots); do $(MAKE) -C $$d clean || exit 1; done
